-- ==================== CHUYỂN MÀU ĐƯỜNG CHÉO LIÊN TỤC (DIAGONAL GRADIENT FLOW) ====================
task.spawn(function()
    local xPos = 1.0
    local offset = 0

    while task.wait(0.015) do
        -- 1. Chữ chạy ngang
        xPos = xPos - 0.006
        if xPos < -1.1 then xPos = 1.0 end
        MarqueeLabel.Position = UDim2.new(xPos, 0, 0, 0)

        -- 2. Dịch chuyển dải màu cầu vồng theo thời gian
        offset = (offset + 0.005) % 1

        -- Tạo ColorSequence 3 điểm màu chuyển động theo đường chéo
        local color1 = Color3.fromHSV(offset, 0.8, 0.9)
        local color2 = Color3.fromHSV((offset + 0.33) % 1, 0.8, 0.9)
        local color3 = Color3.fromHSV((offset + 0.66) % 1, 0.8, 0.9)

        local dynamicSequence = ColorSequence.new({
            ColorSequenceKeypoint.new(0, color1),
            ColorSequenceKeypoint.new(0.5, color2),
            ColorSequenceKeypoint.new(1, color3)
        })

        -- Áp dụng Gradient Đường chéo cho Nền & Viền
        MainGradient.Color = dynamicSequence
        StrokeGradient.Color = dynamicSequence
        MarqueeStrokeGradient.Color = dynamicSequence
        
        LeftGradient.Color = dynamicSequence
        LeftStrokeGradient.Color = dynamicSequence
        
        RightGradient.Color = dynamicSequence
        RightStrokeGradient.Color = dynamicSequence

        -- Đổi màu tiêu đề theo nhịp màu
        HeaderTitle.TextColor3 = color1
    end
end)

