local function UpdateHUD()
    if not _G.UIDEnabled then
        HudFrame.Visible = false
        return
    end
    HudFrame.Visible = true
    
    local pingVal = 0
    pcall(function()
        pingVal = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
    end)
    if pingVal == 0 then
        pingVal = math.floor(Workspace:GetRealPhysicalResponseTime() * 1000)
    end

    local timeTable = os.date("!*t", os.time() + (7 * 3600))
    local status = "Mượt"
    if pingVal > 100 then status = "Bình Thường" end
    if pingVal > 200 then status = "Lag" end
    if pingVal > 350 then status = "Cực Lag" end
    
    HudInfoLabel.Text = string.format("Ping: %d ms (%s) • VN: %02d:%02d:%02d", pingVal, status, timeTable.hour, timeTable.min, timeTable.sec)
end

task.spawn(function()
    while task.wait(0.5) do
        UpdateHUD()
    end
end)

