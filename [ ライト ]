local noclipEnabled = false
local flyjumpEnabled = false
local espEnabled = false
local espObjects = {}
local xrayEnabled = false
local speedEnabled = false
local speedValue = 50
local jumpEnabled = false
local jumpValue = 50
local flyEnabled = false
local flySpeed = 1
local isSitting = false
local isSpinning = false
local ghostState = false
local savedGhostCFrame = nil

-- Bộ lưu trữ màu gốc cho tính năng Chams (Dạng 3)
local originalColors = {}

-- Hàm dọn dẹp ESP và Chams
local function ClearESP()
    for _, item in pairs(espObjects) do
        if item.Text then item.Text:Destroy() end
        if item.Line then item.Line:Destroy() end
        if item.BoxTop then item.BoxTop:Destroy() end
        if item.BoxBottom then item.BoxBottom:Destroy() end
        if item.BoxLeft then item.BoxLeft:Destroy() end
        if item.BoxRight then item.BoxRight:Destroy() end
        if item.HPBar then item.HPBar:Destroy() end
        if item.Highlight then item.Highlight:Destroy() end
    end
    espObjects = {}
    EspFolder:ClearAllChildren()
    
    -- Khôi phục màu gốc của nhân vật (Chams)
    for part, color in pairs(originalColors) do
        if part and part.Parent then
            part.Color = color
        end
    end
    originalColors = {}
end

local function CreateBoxLine(folder)
    local line = Instance.new("Frame", folder or EspFolder)
    line.BorderSizePixel = 0
    line.BackgroundColor3 = THEME.Accent
    line.Visible = false
    return line
end

local function UpdateESP()
    if not espEnabled then ClearESP() return end
    local Camera = Workspace.CurrentCamera
    if not Camera then return end

    -- Nếu đổi sang dạng khác không phải dạng 3, phải khôi phục màu nhân vật
    if _G.ESPMode ~= 4 and next(originalColors) ~= nil then
        for part, color in pairs(originalColors) do
            if part and part.Parent then part.Color = color end
        end
        originalColors = {}
    end

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            if not espObjects[player] then
                local textLabel = Instance.new("TextLabel", EspFolder)
                textLabel.BackgroundTransparency = 1
                textLabel.Size = UDim2.new(0, 200, 0, 30)
                textLabel.TextSize = 12
                textLabel.Font = Enum.Font.FredokaOne

                local lineFrame = Instance.new("Frame", EspFolder)
                lineFrame.BorderSizePixel = 0
                lineFrame.AnchorPoint = Vector2.new(0.5, 0.5)

                local hpBar = Instance.new("Frame", EspFolder)
                hpBar.BorderSizePixel = 0
                hpBar.Visible = false

                local highlight = Instance.new("Highlight", EspFolder)
                highlight.Name = player.Name .. "_Highlight"
                highlight.FillColor = Color3.fromRGB(255, 255, 255)
                highlight.FillTransparency = 0.5
                highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                highlight.OutlineTransparency = 0
                highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                highlight.Visible = false

                espObjects[player] = { 
                    Text = textLabel, Line = lineFrame, HPBar = hpBar, Highlight = highlight,
                    BoxTop = CreateBoxLine(EspFolder), BoxBottom = CreateBoxLine(EspFolder),
                    BoxLeft = CreateBoxLine(EspFolder), BoxRight = CreateBoxLine(EspFolder)
                }
            end

            local data = espObjects[player]
            local char = player.Character
            local myChar = LocalPlayer.Character

            if char and char:FindFirstChild("HumanoidRootPart") and myChar and myChar:FindFirstChild("HumanoidRootPart") then
                local hrp = char.HumanoidRootPart
                local hum = char:FindFirstChildOfClass("Humanoid")
                local head = char:FindFirstChild("Head")
                local screenPos, onScreen = Camera:WorldToViewportPoint(hrp.Position)

                if onScreen and hum and hum.Health > 0 then
                    local dist = math.floor((myChar.HumanoidRootPart.Position - hrp.Position).Magnitude)
                    local hp = math.floor((hum.Health / math.max(hum.MaxHealth, 1)) * 100)
                    
                    -- Reset mặc định
                    data.Highlight.Visible = false
                    data.Highlight.Adornee = nil

                    -- Dạng 1 (Mặc định): Box + Tên + Máu
                    if _G.ESPMode == 1 then
                        data.Text.Visible = true
                        data.Text.Position = UDim2.new(0, screenPos.X - 100, 0, screenPos.Y - 35)
                        data.Text.Text = string.format("%s\nMáu: %d%% | %dm", player.DisplayName, hp, dist)
                        data.Text.TextColor3 = THEME.Accent
                        data.Line.Visible = true
                        data.HPBar.Visible = false
                        
                        local headPos = head and head.Position or (hrp.Position + Vector3.new(0, 2, 0))
                        local headScreen = Camera:WorldToViewportPoint(headPos + Vector3.new(0, 0.5, 0))
                        local legScreen = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))
                        local height = math.abs(headScreen.Y - legScreen.Y)
                        local width = height * 0.6
                        local boxX = screenPos.X - (width / 2)
                        local boxY = headScreen.Y
                        data.BoxTop.Visible, data.BoxTop.Position, data.BoxTop.Size, data.BoxTop.BackgroundColor3 = true, UDim2.new(0, boxX, 0, boxY), UDim2.new(0, width, 0, 1.5), THEME.Accent
                        data.BoxBottom.Visible, data.BoxBottom.Position, data.BoxBottom.Size, data.BoxBottom.BackgroundColor3 = true, UDim2.new(0, boxX, 0, boxY + height), UDim2.new(0, width, 0, 1.5), THEME.Accent
                        data.BoxLeft.Visible, data.BoxLeft.Position, data.BoxLeft.Size, data.BoxLeft.BackgroundColor3 = true, UDim2.new(0, boxX, 0, boxY), UDim2.new(0, 1.5, 0, height), THEME.Accent
                        data.BoxRight.Visible, data.BoxRight.Position, data.BoxRight.Size, data.BoxRight.BackgroundColor3 = true, UDim2.new(0, boxX + width, 0, boxY), UDim2.new(0, 1.5, 0, height), THEME.Accent
                    
                    -- Dạng 2 (Viền trắng): Highlight trắng + Box + Máu
                    elseif _G.ESPMode == 2 then
                        data.Text.Visible = true
                        data.Text.Position = UDim2.new(0, screenPos.X - 100, 0, screenPos.Y - 50)
                        data.Text.Text = string.format("%s [%d%%]", player.DisplayName, hp)
                        data.Text.TextColor3 = Color3.fromRGB(255, 255, 255)
                        data.Line.Visible = false
                        data.HPBar.Visible = true
                        
                        -- Hiển thị viền trắng Highlight
                        data.Highlight.Visible = true
                        data.Highlight.Adornee = char
                        
                        local headPos = head and head.Position or (hrp.Position + Vector3.new(0, 2, 0))
                        local headScreen = Camera:WorldToViewportPoint(headPos + Vector3.new(0, 0.5, 0))
                        local legScreen = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))
                        local height = math.abs(headScreen.Y - legScreen.Y)
                        local width = height * 0.6
                        local boxX = screenPos.X - (width / 2)
                        local boxY = headScreen.Y
                        data.BoxTop.Visible, data.BoxTop.Position, data.BoxTop.Size, data.BoxTop.BackgroundColor3 = true, UDim2.new(0, boxX, 0, boxY), UDim2.new(0, width, 0, 1.5), Color3.fromRGB(255, 255, 255)
                        data.BoxBottom.Visible, data.BoxBottom.Position, data.BoxBottom.Size, data.BoxBottom.BackgroundColor3 = true, UDim2.new(0, boxX, 0, boxY + height), UDim2.new(0, width, 0, 1.5), Color3.fromRGB(255, 255, 255)
                        data.BoxLeft.Visible, data.BoxLeft.Position, data.BoxLeft.Size, data.BoxLeft.BackgroundColor3 = true, UDim2.new(0, boxX, 0, boxY), UDim2.new(0, 1.5, 0, height), Color3.fromRGB(255, 255, 255)
                        data.BoxRight.Visible, data.BoxRight.Position, data.BoxRight.Size, data.BoxRight.BackgroundColor3 = true, UDim2.new(0, boxX + width, 0, boxY), UDim2.new(0, 1.5, 0, height), Color3.fromRGB(255, 255, 255)
                        
                        data.HPBar.Position = UDim2.new(0, boxX - 5, 0, boxY)
                        data.HPBar.Size = UDim2.new(0, 2, 0, height * (hp/100))
                        data.HPBar.BackgroundColor3 = Color3.fromRGB(0, 255, 0)

                    -- Dạng 3: Chỉ Tên
                    elseif _G.ESPMode == 3 then
                        data.Text.Visible = true
                        data.Text.Position = UDim2.new(0, screenPos.X - 100, 0, screenPos.Y - 30)
                        data.Text.Text = player.DisplayName
                        data.Text.TextColor3 = Color3.fromRGB(255, 255, 255)
                        data.Line.Visible = false
                        data.HPBar.Visible = false
                        data.BoxTop.Visible, data.BoxBottom.Visible, data.BoxLeft.Visible, data.BoxRight.Visible = false, false, false, false
                    
                    -- Dạng 4 (Trắng toàn thân): Chams Trắng + Tên + Máu + Khoảng cách
                    elseif _G.ESPMode == 4 then
                        data.Text.Visible = true
                        data.Text.Position = UDim2.new(0, screenPos.X - 100, 0, screenPos.Y - 35)
                        data.Text.Text = string.format("%s\nMáu: %d%% | %dm", player.DisplayName, hp, dist)
                        data.Text.TextColor3 = Color3.fromRGB(255, 255, 255)
                        data.Line.Visible = false
                        data.HPBar.Visible = false
                        data.BoxTop.Visible, data.BoxBottom.Visible, data.BoxLeft.Visible, data.BoxRight.Visible = false, false, false, false

                        -- Sơn trắng toàn bộ nhân vật (Chams)
                        for _, part in ipairs(char:GetDescendants()) do
                            if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                                if not originalColors[part] then
                                    originalColors[part] = part.Color
                                end
                                part.Color = Color3.fromRGB(255, 255, 255) -- Sơn trắng
                                part.Material = Enum.Material.SmoothPlastic -- Bỏ texture
                            end
                        end
                    end
                else
                    data.Text.Visible = false
                    data.Line.Visible = false
                    data.HPBar.Visible = false
                    data.Highlight.Visible = false
                    data.BoxTop.Visible, data.BoxBottom.Visible, data.BoxLeft.Visible, data.BoxRight.Visible = false, false, false, false
                end
            end
        end
    end
end
