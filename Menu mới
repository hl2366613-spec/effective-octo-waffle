local function CreateFeatureRow(name, mode, placeholder)
    local Frame = Instance.new("Frame", Scroll)
    Frame.BackgroundColor3 = Color3.fromRGB(25, 28, 39)
    Frame.Size = UDim2.new(1, -6, 0, 38)
    Frame.ZIndex = 12
    Instance.new("UICorner", Frame).CornerRadius = UDim.new(0, 8)

    local Label = Instance.new("TextLabel", Frame)
    Label.BackgroundTransparency = 1
    Label.Position = UDim2.new(0, 10, 0, 0)
    Label.Size = UDim2.new(0.35, 0, 1, 0)
    Label.Font = Enum.Font.GothamBold
    Label.Text = name
    Label.TextColor3 = Color3.fromRGB(230, 235, 245)
    Label.TextSize = 12
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.ZIndex = 13

    local ValBtn = nil
    if mode == "Value" or mode == "Player" then
        ValBtn = Instance.new("TextButton", Frame)
        ValBtn.BackgroundColor3 = Color3.fromRGB(14, 16, 23)
        ValBtn.Position = UDim2.new(0.38, 0, 0.18, 0)
        ValBtn.Size = UDim2.new(0.42, 0, 0.64, 0)
        ValBtn.Font = Enum.Font.GothamBold
        ValBtn.Text = placeholder
        ValBtn.TextColor3 = Color3.fromRGB(255, 210, 90)
        ValBtn.TextSize = 10
        ValBtn.ZIndex = 13
        Instance.new("UICorner", ValBtn).CornerRadius = UDim.new(0, 5)
    end

    local ToggleBtn = Instance.new("TextButton", Frame)
    ToggleBtn.Position = UDim2.new(1, -30, 0.5, -10)
    ToggleBtn.Size = UDim2.new(0, 20, 0, 20)
    ToggleBtn.BackgroundColor3 = Color3.fromRGB(45, 50, 65)
    ToggleBtn.Font = Enum.Font.GothamBold
    ToggleBtn.Text = ""
    ToggleBtn.ZIndex = 13
    Instance.new("UICorner", ToggleBtn).CornerRadius = UDim.new(1, 0)

    local isToggled = false

    if ValBtn and mode == "Value" then
        ValBtn.MouseButton1Click:Connect(function()
            VMTitle.Text = "☀️ Chỉnh " .. name
            activeToggleBtn = ToggleBtn
            activeValueLabel = ValBtn
            ValueModal.Visible = true
            PlayerModal.Visible = false
        end)
    end

    if ValBtn and mode == "Player" then
        ValBtn.MouseButton1Click:Connect(function()
            PMTitle.Text = "☀️ Chọn Player: " .. name
            activeToggleBtn = ToggleBtn
            activeValueLabel = ValBtn

            for _, child in pairs(PMScroll:GetChildren()) do
                if child:IsA("Frame") then child:Destroy() end
            end

            for _, plr in pairs(Players:GetPlayers()) do
                local PFrame = Instance.new("Frame", PMScroll)
                PFrame.BackgroundColor3 = Color3.fromRGB(30, 34, 48)
                PFrame.Size = UDim2.new(1, 0, 0, 32)
                PFrame.ZIndex = 102
                Instance.new("UICorner", PFrame).CornerRadius = UDim.new(0, 6)

                local Avatar = Instance.new("ImageLabel", PFrame)
                Avatar.Position = UDim2.new(0, 5, 0.1, 0)
                Avatar.Size = UDim2.new(0, 25, 0, 25)
                Avatar.BackgroundTransparency = 1
                Avatar.Image = "rbxthumb://type=AvatarHeadShot&id=" .. plr.UserId .. "&w=150&h=150"
                Avatar.ZIndex = 103

                local PBtn = Instance.new("TextButton", PFrame)
                PBtn.Position = UDim2.new(0, 36, 0, 0)
                PBtn.Size = UDim2.new(1, -36, 1, 0)
                PBtn.BackgroundTransparency = 1
                PBtn.Font = Enum.Font.GothamBold
                PBtn.Text = plr.DisplayName
                PBtn.TextColor3 = Color3.fromRGB(255, 220, 120)
                PBtn.TextSize = 10
                PBtn.TextXAlignment = Enum.TextXAlignment.Left
                PBtn.ZIndex = 103

                PBtn.MouseButton1Click:Connect(function()
                    activeValueLabel.Text = plr.DisplayName
                end)
            end

            PlayerModal.Visible = true
            ValueModal.Visible = false
        end)
    end

    ToggleBtn.MouseButton1Click:Connect(function()
        isToggled = not isToggled
        ToggleBtn.BackgroundColor3 = isToggled and Color3.fromRGB(255, 190, 40) or Color3.fromRGB(45, 50, 65)
    end)
end

