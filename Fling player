-- Hàm Fling
local function flingTarget(target)
    if not target or not target.Character then 
        statusLabel.Text = "❌ Không tìm thấy người chơi!"
        statusLabel.TextColor3 = Color3.fromRGB(255, 0, 0)
        return 
    end
    
    local targetRoot = target.Character:FindFirstChild("HumanoidRootPart")
    local targetHumanoid = target.Character:FindFirstChild("Humanoid")
    
    if not targetRoot or not targetHumanoid then 
        statusLabel.Text = "❌ Không thể fling!"
        statusLabel.TextColor3 = Color3.fromRGB(255, 0, 0)
        return 
    end
    
    isFlinging = true
    statusLabel.Text = "🔄 Đang bay đến " .. target.Name .. "..."
    statusLabel.TextColor3 = Color3.fromRGB(255, 200, 0)
    
    -- Tạo BodyVelocity để bay đến
    local bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
    bv.Parent = rootPart
    
    -- Vòng lặp bay đến mục tiêu trong 5 giây
    local startTime = tick()
    local duration = 5
    
    while tick() - startTime < duration and isFlingEnabled do
        if targetRoot and targetRoot.Position then
            local direction = (targetRoot.Position - rootPart.Position).Unit
            local distance = (targetRoot.Position - rootPart.Position).Magnitude
            
            -- Điều chỉnh tốc độ theo khoảng cách
            local speed = math.min(distance * 0.5 + 50, 200)
            
            bv.Velocity = direction * speed + Vector3.new(0, 20, 0)
            
            -- Cập nhật status
            local timeLeft = math.ceil(duration - (tick() - startTime))
            statusLabel.Text = "🔄 Đang bay đến " .. target.Name .. "... " .. timeLeft .. "s"
        end
        task.wait(0.05)
    end
    
    -- Đá player đi (Fling)
    if targetRoot and isFlingEnabled then
        statusLabel.Text = "💥 ĐANG FLING " .. target.Name .. "!!!"
        statusLabel.TextColor3 = Color3.fromRGB(255, 0, 0)
        
        -- Tạo lực đẩy mạnh
        local flingVelocity = Instance.new("BodyVelocity")
        flingVelocity.MaxForce = Vector3.new(1e9, 1e9, 1e9)
        flingVelocity.Velocity = Vector3.new(
            math.random(-5000, 5000),
            math.random(3000, 8000),
            math.random(-5000, 5000)
        )
        flingVelocity.Parent = targetRoot
        
        -- Thêm BodyForce để đẩy mạnh hơn
        local bf = Instance.new("BodyForce")
        bf.Force = Vector3.new(0, 500000, 0)
        bf.Parent = targetRoot
        
        -- Xóa sau 2 giây
        game:GetService("Debris"):AddItem(flingVelocity, 2)
        game:GetService("Debris"):AddItem(bf, 2)
        
        -- Hiệu ứng
        for i = 1, 5 do
            if targetRoot then
                local part = Instance.new("Part")
                part.Size = Vector3.new(1, 1, 1)
                part.Position = targetRoot.Position + Vector3.new(math.random(-10, 10), math.random(-10, 10), math.random(-10, 10))
                part.BrickColor = BrickColor.Red()
                part.Material = Enum.Material.Neon
                part.Anchored = true
                part.CanCollide = false
                part.Parent = game.Workspace
                game:GetService("Debris"):AddItem(part, 0.5)
            end
            task.wait(0.1)
        end
        
        statusLabel.Text = "✅ Đã fling " .. target.Name .. "!"
        statusLabel.TextColor3 = Color3.fromRGB(0, 255, 0)
    end
    
    -- Xóa BodyVelocity của chính mình
    bv:Destroy()
    isFlinging = false
end

-- Sự kiện toggle
toggleButton.MouseButton1Click:Connect(function()
    isFlingEnabled = not isFlingEnabled
    updateToggleButton()
    
    if isFlingEnabled then
        statusLabel.Text = "🟢 Đã bật FLING"
        statusLabel.TextColor3 = Color3.fromRGB(0, 255, 0)
        
        -- Chọn player từ search box
        local targetName = searchBox.Text
        if targetName ~= "" then
            for _, p in pairs(game.Players:GetPlayers()) do
                if p.Name:lower():find(targetName:lower()) and p ~= player then
                    targetPlayer = p
                    statusLabel.Text = "✅ Đã chọn: " .. p.Name
                    statusLabel.TextColor3 = Color3.fromRGB(0, 255, 0)
                    break
                end
            end
        end
        
        -- Bắt đầu coroutine fling
        if flingCoroutine then
            coroutine.close(flingCoroutine)
        end
        
        flingCoroutine = coroutine.create(function()
            while isFlingEnabled do
                if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
                    flingTarget(targetPlayer)
                else
                    -- Tìm player mới nếu target bị disconnect
                    for _, p in pairs(game.Players:GetPlayers()) do
                        if p ~= player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                            targetPlayer = p
                            statusLabel.Text = "🔄 Đã chuyển sang: " .. p.Name
                            statusLabel.TextColor3 = Color3.fromRGB(255, 200, 0)
                            break
                        end
                    end
                end
                task.wait(6) -- Chờ 6 giây trước khi fling lại
            end
        end)
        
        coroutine.resume(flingCoroutine)
        
    else
        statusLabel.Text = "🔴 Đã tắt FLING"
        statusLabel.TextColor3 = Color3.fromRGB(255, 0, 0)
        isFlinging = false
        
        -- Dừng coroutine
        if flingCoroutine then
            coroutine.close(flingCoroutine)
            flingCoroutine = nil
        end
    end
end)

