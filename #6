local function StopKill()
    if killConnection then killConnection:Disconnect() killConnection = nil end
end

local function StartKill()
    StopKill()
    killConnection = RunService.Heartbeat:Connect(function()
        if not killEnabled then StopKill() return end
        local char = LocalPlayer.Character
        if not char then return end
        local tool = char:FindFirstChildOfClass("Tool")
        if not tool then return end
        local handle = tool:FindFirstChild("Handle") or tool:FindFirstChildOfClass("BasePart")
        tool:Activate()

        local targets = {}
        if selectedKillPlayer == "ALL" then
            for _, p in pairs(Players:GetPlayers()) do if p ~= LocalPlayer then table.insert(targets, p) end end
        elseif typeof(selectedKillPlayer) == "Instance" and selectedKillPlayer:IsA("Player") then
            table.insert(targets, selectedKillPlayer)
        end

        for _, target in pairs(targets) do
            if target and target.Character then
                local tHrp = target.Character:FindFirstChild("HumanoidRootPart") or target.Character:FindFirstChild("Head")
                local tHum = target.Character:FindFirstChildOfClass("Humanoid")
                if tHrp and tHum and tHum.Health > 0 and handle and handle:FindFirstChildOfClass("TouchTransmitter") then
                    firetouchinterest(handle, tHrp, 0)
                    firetouchinterest(handle, tHrp, 1)
                end
            end
        end
    end)
end

local function GetRandomValidPlayer()
    local validPlayers = {}
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local tHum = p.Character:FindFirstChildOfClass("Humanoid")
            local tHrp = p.Character:FindFirstChild("HumanoidRootPart") or p.Character:FindFirstChild("Head")
            if tHum and tHrp and tHum.Health > 0 then table.insert(validPlayers, p) end
        end
    end
    return #validPlayers > 0 and validPlayers[math.random(1, #validPlayers)] or nil
end

local function StopSwordKill()
    if swordKillConnection then swordKillConnection:Disconnect() swordKillConnection = nil end
    currentSwordTarget = nil
end

local function StartSwordKill()
    StopSwordKill()
    swordKillConnection = RunService.Heartbeat:Connect(function()
        if not swordKillEnabled then StopSwordKill() return end
        local char = LocalPlayer.Character
        if not char then return end
        local myHrp = char:FindFirstChild("HumanoidRootPart")
        local tool = char:FindFirstChildOfClass("Tool")
        if not myHrp or not tool then return end
        local handle = tool:FindFirstChild("Handle") or tool:FindFirstChildOfClass("BasePart")

        if selectedSwordPlayer == "RANDOM" then
            local isTargetValid = false
            if currentSwordTarget and currentSwordTarget.Parent and currentSwordTarget.Character then
                local tHum = currentSwordTarget.Character:FindFirstChildOfClass("Humanoid")
                local tHrp = currentSwordTarget.Character:FindFirstChild("HumanoidRootPart") or currentSwordTarget.Character:FindFirstChild("Head")
                if tHum and tHrp and tHum.Health > 0 then isTargetValid = true end
            end
            if not isTargetValid then currentSwordTarget = GetRandomValidPlayer() end
        else
            currentSwordTarget = selectedSwordPlayer
        end

        if currentSwordTarget and currentSwordTarget.Character then
            local tChar = currentSwordTarget.Character
            local tHum = tChar:FindFirstChildOfClass("Humanoid")
            local targetPart = tChar:FindFirstChild("Head") or tChar:FindFirstChild("UpperTorso") or tChar:FindFirstChild("Torso") or tChar:FindFirstChild("HumanoidRootPart")

            if targetPart and tHum and tHum.Health > 0 then
                myHrp.CFrame = targetPart.CFrame
                myHrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                tool:Activate()
                if handle and handle:FindFirstChildOfClass("TouchTransmitter") then
                    for _, child in ipairs(tChar:GetChildren()) do
                        if child:IsA("BasePart") then
                            firetouchinterest(handle, child, 0)
                            firetouchinterest(handle, child, 1)
                        end
                    end
                end
            end
        end
    end)
end

local function RefreshSubMenu()
