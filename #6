        end)
    elseif subMenuMode == "kill" then
        local allBtn = Instance.new("TextButton", CustomList)
        allBtn.Size = UDim2.new(1, 0, 0, 25)
        allBtn.BackgroundColor3 = Color3.fromRGB(35, 15, 25)
