local function StopFly()
    if flyConnection then flyConnection:Disconnect() flyConnection = nil end
    if flyBodyGyro then flyBodyGyro:Destroy() flyBodyGyro = nil end
    if flyBodyVelocity then flyBodyVelocity:Destroy() flyBodyVelocity = nil end
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") then
        LocalPlayer.Character:FindFirstChildOfClass("Humanoid").PlatformStand = false
    end
end

local function StartFly()
    StopFly()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local root = char.HumanoidRootPart
    hum.PlatformStand = true

    flyBodyGyro = Instance.new("BodyGyro", root)
    flyBodyGyro.P = 9e4
    flyBodyGyro.maxTorque = Vector3.new(9e9, 9e9, 9e9)
    flyBodyGyro.CFrame = root.CFrame

    flyBodyVelocity = Instance.new("BodyVelocity", root)
    flyBodyVelocity.Velocity = Vector3.new(0, 0, 0)
    flyBodyVelocity.MaxForce = Vector3.new(9e9, 9e9, 9e9)

    flyConnection = RunService.RenderStepped:Connect(function()
        local Camera = Workspace.CurrentCamera
        if not flyEnabled or not Camera then StopFly() return end
        local moveDir = hum.MoveDirection
        local calcSpeed = flySpeed * 50

        if moveDir.Magnitude > 0 then
            local flyVec = Camera.CFrame:VectorToWorldSpace(CFrame.new(moveDir:Dot(Camera.CFrame.RightVector), 0, moveDir:Dot(-Camera.CFrame.LookVector)).Position)
            flyBodyVelocity.Velocity = flyVec.Unit * calcSpeed
        else
            flyBodyVelocity.Velocity = Vector3.new(0, 0, 0)
        end
        if hum.Jump then
            flyBodyVelocity.Velocity = flyBodyVelocity.Velocity + Vector3.new(0, calcSpeed, 0)
            hum.Jump = false
        end
        flyBodyGyro.CFrame = Camera.CFrame
    end)
end

