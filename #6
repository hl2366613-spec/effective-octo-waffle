local chatShowing = false
local chatBillboard = nil

local function UpdateOverheadChat()
    local char = LocalPlayer.Character
    if not char then return end
    local head = char:FindFirstChild("Head")
    if not head then return end

    if chatShowing then
        if not chatBillboard or not chatBillboard.Parent then
            chatBillboard = Instance.new("BillboardGui")
            chatBillboard.Name = "ChatSimBillboard"
            chatBillboard.Size = UDim2.new(0, 200, 0, 50)
            chatBillboard.StudsOffset = Vector3.new(0, 2.5, 0)
            chatBillboard.AlwaysOnTop = true
            chatBillboard.Parent = head

            local textLabel = Instance.new("TextLabel")
            textLabel.Name = "ChatText"
            textLabel.Size = UDim2.new(1, 0, 1, 0)
            textLabel.BackgroundTransparency = 1
            textLabel.Font = Enum.Font.SourceSansBold
            textLabel.TextSize = 16
            textLabel.TextStrokeTransparency = 0
            textLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
            textLabel.Parent = chatBillboard
        end

        local textLabel = chatBillboard:FindFirstChild("ChatText")
        if textLabel then
            textLabel.Text = ChatInput.Text
            textLabel.TextColor3 = isRainbowChat and currentRainbowColor or selectedChatColor
        end
    else
        if chatBillboard then
            chatBillboard:Destroy()
            chatBillboard = nil
        end
    end
end

ChatToggleBtn.MouseButton1Click:Connect(function()
    chatShowing = not chatShowing
    if chatShowing then
        ChatToggleBtn.Text = "off"
        ChatToggleBtn.TextColor3 = Color3.fromRGB(255, 100, 100)
    else
        ChatToggleBtn.Text = "on"
        ChatToggleBtn.TextColor3 = Color3.fromRGB(100, 255, 100)
    end
    UpdateOverheadChat()
end)

