-- =========================================================
-- FLY (HOÀN TOÀN GIỐNG INFINITE YIELD MƯỢT MÀ, NOCLIP, XOAY CAMERA)
-- =========================================================

local function UpdateFlyLabel()
    FlyToggleBtn.Text = flyEnabled and ("🐾 Fly: ON (" .. flySpeed .. ")") or ("🐾 Fly: OFF (" .. flySpeed .. ")")
end

local function StopFly()
    if flyConnection then
        flyConnection:Disconnect()
        flyConnection = nil
    end

    local char = LocalPlayer.Character
    if char then
        local root = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if root then
            root.Velocity = Vector3.zero
        end
        if hum then
            hum.PlatformStand = false
        end
        -- Khôi phục noclip
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = true
            end
        end
    end
end

local function StartFly()
    StopFly()

    local char = LocalPlayer.Character
    if not char then return end

    local root = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not root or not hum then return end

    flyConnection = RunService.RenderStepped:Connect(function(delta)
        if not flyEnabled or not char or not root or not hum then
            StopFly()
            return
        end

        hum.PlatformStand = true

        -- Noclip mượt
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end

        local camera = Workspace.CurrentCamera
        local moveVector = hum.MoveDirection

        root.Velocity = Vector3.zero
        root.CFrame = CFrame.new(root.Position, root.Position + camera.CFrame.LookVector)

        if moveVector.Magnitude > 0 then
            local flyCF = camera.CFrame
            local moveDir = (flyCF.RightVector * moveVector.X + flyCF.LookVector * -moveVector.Z).Unit
            root.CFrame = root.CFrame + (moveDir * (flySpeed * 50) * delta)
        end
    end)
end

