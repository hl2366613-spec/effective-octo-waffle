    else
        if sitConnection then sitConnection:Disconnect() sitConnection = nil end
        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") then
            LocalPlayer.Character:FindFirstChildOfClass("Humanoid").Sit = false
        end
    end
end

local function ToggleSpin()
    isSpinning = not isSpinning
    SpinBtn.Text = isSpinning and "🐾 Spin: ON" or "🐾 Spin: OFF"
    SpinBtn.TextColor3 = isSpinning and THEME.Active or THEME.Inactive
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart

    if isSpinning then
        local attach = hrp:FindFirstChild("SpinAttachment") or Instance.new("Attachment", hrp)
        attach.Name = "SpinAttachment"
        local spinVel = Instance.new("AngularVelocity", hrp)
        spinVel.Name = "SpinVelocity"
        spinVel.Attachment0 = attach
        spinVel.MaxTorque = math.huge
        spinVel.AngularVelocity = Vector3.new(0, 25, 0)
    else
        if hrp:FindFirstChild("SpinVelocity") then hrp.SpinVelocity:Destroy() end
        if hrp:FindFirstChild("SpinAttachment") then hrp.SpinAttachment:Destroy() end
    end
end

local function StopGlue()
    if glueConnection then glueConnection:Disconnect() glueConnection = nil end
end

local function StartGlue()
    StopGlue()
    if not selectedGluePlayer then
        isGlueActive = false
        GlueToggleBtn.Text = "🎀 Bám onii chan: OFF"
        GlueToggleBtn.TextColor3 = THEME.Inactive
        return
    end

    glueConnection = RunService.Heartbeat:Connect(function()
        if not isGlueActive then StopGlue() return end
        local targetChar, myChar = selectedGluePlayer.Character, LocalPlayer.Character
        if not targetChar or not myChar then StopGlue() isGlueActive = false return end

        local tHead = targetChar:FindFirstChild("Head") or targetChar:FindFirstChild("HumanoidRootPart")
        local myHrp = myChar:FindFirstChild("HumanoidRootPart")
        if tHead and myHrp then
            local offset = tHead.CFrame:VectorToWorldSpace(Vector3.new(tHead.Size.X / 2 + 0.5, 0.3, 0))
            myHrp.CFrame = CFrame.new(tHead.Position + offset)
            myHrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        end
    end)
end

local function TeleportToSelected()
    if selectedTPPlayer and selectedTPPlayer.Character and LocalPlayer.Character then
        local tHrp = selectedTPPlayer.Character:FindFirstChild("HumanoidRootPart")
        local myHrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if tHrp and myHrp then myHrp.CFrame = tHrp.CFrame + Vector3.new(0, 3, 0) end
    end
end

