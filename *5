local function CreateBoxLine()
    local line = Instance.new("Frame", EspFolder)
    line.BorderSizePixel = 0
    line.BackgroundColor3 = THEME.Accent
    line.Visible = false
    return line
end

local function UpdateESP()
    if not espEnabled then ClearESP() return end
    local Camera = Workspace.CurrentCamera
    if not Camera then return end

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            if not espObjects[player] then
                local textLabel = Instance.new("TextLabel", EspFolder)
                textLabel.BackgroundTransparency = 1
                textLabel.Size = UDim2.new(0, 200, 0, 30)
                textLabel.TextSize = 12
                textLabel.Font = Enum.Font.FredokaOne

                local lineFrame = Instance.new("Frame", EspFolder)
                lineFrame.BorderSizePixel = 0
                lineFrame.AnchorPoint = Vector2.new(0.5, 0.5)

                espObjects[player] = { 
                    Text = textLabel, Line = lineFrame,
                    BoxTop = CreateBoxLine(), BoxBottom = CreateBoxLine(),
                    BoxLeft = CreateBoxLine(), BoxRight = CreateBoxLine()
                }
            end

            local data = espObjects[player]
            local char = player.Character
            local myChar = LocalPlayer.Character

            if char and char:FindFirstChild("HumanoidRootPart") and myChar and myChar:FindFirstChild("HumanoidRootPart") then
                local hrp = char.HumanoidRootPart
                local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or hrp
                local head = char:FindFirstChild("Head")
                local hum = char:FindFirstChildOfClass("Humanoid")
                local screenPosTorso, onScreen = Camera:WorldToViewportPoint(torso.Position)

                if onScreen and hum and hum.Health > 0 then
                    local dist = math.floor((myChar.HumanoidRootPart.Position - hrp.Position).Magnitude)
                    local hp = math.floor((hum.Health / math.max(hum.MaxHealth, 1)) * 100)

                    data.Text.Visible = true
                    data.Text.Position = UDim2.new(0, screenPosTorso.X - 100, 0, screenPosTorso.Y - 35)
                    data.Text.Text = string.format("%s\nMáu: %d%% | %dm", player.DisplayName, hp, dist)
                    data.Text.TextColor3 = THEME.Accent

                    data.Line.Visible = true
                    data.Line.BackgroundColor3 = THEME.Accent
                    local startPos = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y * 0.35)
                    local distance = (Vector2.new(screenPosTorso.X, screenPosTorso.Y) - startPos).Magnitude
                    local angle = math.atan2(screenPosTorso.Y - startPos.Y, screenPosTorso.X - startPos.X)
                    data.Line.Size = UDim2.new(0, distance, 0, 1.5)
                    data.Line.Position = UDim2.new(0, (startPos.X + screenPosTorso.X) / 2, 0, (startPos.Y + screenPosTorso.Y) / 2)
                    data.Line.Rotation = math.deg(angle)

                    local headPos = head and head.Position or (hrp.Position + Vector3.new(0, 2, 0))
                    local headScreen = Camera:WorldToViewportPoint(headPos + Vector3.new(0, 0.5, 0))
                    local legScreen = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))
                    local height = math.abs(headScreen.Y - legScreen.Y)
                    local width = height * 0.6
                    local boxX = screenPosTorso.X - (width / 2)
                    local boxY = headScreen.Y

                    data.BoxTop.Visible = true data.BoxTop.Position = UDim2.new(0, boxX, 0, boxY) data.BoxTop.Size = UDim2.new(0, width, 0, 1.5) data.BoxTop.BackgroundColor3 = THEME.Accent
                    data.BoxBottom.Visible = true data.BoxBottom.Position = UDim2.new(0, boxX, 0, boxY + height) data.BoxBottom.Size = UDim2.new(0, width, 0, 1.5) data.BoxBottom.BackgroundColor3 = THEME.Accent
                    data.BoxLeft.Visible = true data.BoxLeft.Position = UDim2.new(0, boxX, 0, boxY) data.BoxLeft.Size = UDim2.new(0, 1.5, 0, height) data.BoxLeft.BackgroundColor3 = THEME.Accent
                    data.BoxRight.Visible = true data.BoxRight.Position = UDim2.new(0, boxX + width, 0, boxY) data.BoxRight.Size = UDim2.new(0, 1.5, 0, height) data.BoxRight.BackgroundColor3 = THEME.Accent
                else
                    data.Text.Visible, data.Line.Visible, data.BoxTop.Visible, data.BoxBottom.Visible, data.BoxLeft.Visible, data.BoxRight.Visible = false, false, false, false, false, false
                end
            else
                data.Text.Visible, data.Line.Visible, data.BoxTop.Visible, data.BoxBottom.Visible, data.BoxLeft.Visible, data.BoxRight.Visible = false, false, false, false, false, false
            end
        end
    end
end

