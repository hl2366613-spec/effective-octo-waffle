        CreateStroke(autoBtn, 1, THEME.Border)
        autoBtn.MouseButton1Click:Connect(function()
            selectedAimPlayer = nil SelectAimPlayerBtn.Text = "[ AIM: GẦN NHẤT ]" SubFrame.Visible = false
        end)
    elseif subMenuMode == "kill" then
