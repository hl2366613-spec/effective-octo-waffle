-- Core Functional Routines
local function ApplySpeed()
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") then
        LocalPlayer.Character:FindFirstChildOfClass("Humanoid").WalkSpeed = speedEnabled and speedValue or 16
    end
end

local function ApplyJump()
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") then
        LocalPlayer.Character:FindFirstChildOfClass("Humanoid").JumpPower = jumpEnabled and jumpValue or 50
    end
end

local function RefreshPlayerList()
    for _, child in pairs(PlayerList:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end

    local count = 0
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            count = count + 1
            local btn = Instance.new("TextButton")
            btn.Size = UDim2.new(1, 0, 0, 25)
            btn.BackgroundColor3 = Color3.fromRGB(18, 15, 25)
            btn.Text = player.DisplayName
            btn.TextColor3 = Color3.fromRGB(255, 255, 255)
            btn.Font = Enum.Font.SourceSansBold
            btn.Parent = PlayerList
            CreateCorner(btn, 6)
            RegisterStroke(CreateStroke(btn, 1))

            btn.MouseButton1Click:Connect(function()
                if subMenuMode == "glue" then selectedGluePlayer = player SelectGluePlayerBtn.Text = "[ KEO ]: " .. player.DisplayName
                elseif subMenuMode == "tp" then selectedTPPlayer = player SelectTPPlayerBtn.Text = "[ TP ]: " .. player.DisplayName
                elseif subMenuMode == "view" then selectedViewPlayer = player SelectViewPlayerBtn.Text = "[ VIEW ]: " .. player.DisplayName
                elseif subMenuMode == "aim" then selectedAimPlayer = player SelectAimPlayerBtn.Text = "[ AIM ]: " .. player.DisplayName
                elseif subMenuMode == "kill" then selectedKillPlayer = player SelectKillPlayerBtn.Text = "[ KILL ]: " .. player.DisplayName
                elseif subMenuMode == "swordkill" then selectedSwordPlayer = player SelectSwordKillPlayerBtn.Text = "[ SWORD ]: " .. player.DisplayName end
                SubFrame.Visible = false
            end)
        end
    end
    PlayerList.CanvasSize = UDim2.new(0, 0, 0, count * 29)
end

local function OpenSubMenu(mode)
    subMenuMode = mode
    RefreshPlayerList()
    SubFrame.Visible = true
end

