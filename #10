-- Animation Loop & Color Refresh
local hue = 0
RunService.Heartbeat:Connect(function(dt)
    hue = (hue + dt * 0.3) % 1
    currentRainbowColor = Color3.fromHSV(hue, 0.85, 1)

    MainUIStroke.Color = currentRainbowColor
    SubUIStroke.Color = currentRainbowColor
    OpenBtnStroke.Color = currentRainbowColor
    CloseStroke.Color = currentRainbowColor
    TopLine.BackgroundColor3 = currentRainbowColor

    for _, stroke in ipairs(RainbowStrokes) do
        if stroke and stroke.Parent then stroke.Color = currentRainbowColor end
    end

    Title.TextColor3 = currentRainbowColor
    VersionLabel.TextColor3 = currentRainbowColor
    OpenBtn.TextColor3 = currentRainbowColor
end)

