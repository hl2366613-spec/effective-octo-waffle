    Item.MouseLeave:Connect(function()
        Tween(Item, TweenInfo.new(.12), {
            BackgroundColor3 = CARD2
        })
    end)

    Item.MouseButton1Click:Connect(function()

        SelectedText.Text = player.DisplayName
        SelectedText.TextColor3 = WHITE

        -- Chỉ chọn player, không thực hiện chức năng
        ListFrame.Visible = false
    end)
end

--========================================================
-- Refresh players
--========================================================

local function RefreshPlayers()

    for _, child in ipairs(Scroll:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LP then
            CreatePlayerItem(player)
        end
    end

    task.wait()

    Scroll.CanvasSize = UDim2.new(
        0,
        0,
        0,
        Layout.AbsoluteContentSize.Y + 10
    )
end

RefreshPlayers()

Players.PlayerAdded:Connect(function()
    task.wait(.3)
    RefreshPlayers()
end)

Players.PlayerRemoving:Connect(function()
    task.wait(.3)
    RefreshPlayers()
end)

--========================================================
-- Search filter
--========================================================

Search:GetPropertyChangedSignal("Text"):Connect(function()

    local query = string.lower(Search.Text)

    for _, item in ipairs(Scroll:GetChildren()) do

        if item:IsA("TextButton") then

            local name = string.lower(item.Name)

            item.Visible = query == "" or string.find(name, query, 1, true) ~= nil
        end
    end
end)

