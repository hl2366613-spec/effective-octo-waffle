    Username.Position = UDim2.fromOffset(62, 30)
    Username.BackgroundTransparency = 1
    Username.Text = "@" .. player.Name
    Username.TextColor3 = GRAY
    Username.TextSize = 12
    Username.Font = Enum.Font.Gotham
    Username.TextXAlignment = Enum.TextXAlignment.Left
    Username.TextTruncate = Enum.TextTruncate.AtEnd
    Username.ZIndex = 53
    Username.Parent = Item

    local Select = Instance.new("TextLabel")
    Select.Size = UDim2.fromOffset(65, 30)
    Select.Position = UDim2.new(1, -75, 0.5, -15)
    Select.BackgroundColor3 = PURPLE2
    Select.Text = "CHỌN"
    Select.TextColor3 = WHITE
    Select.TextSize = 11
    Select.Font = Enum.Font.GothamBold
    Select.ZIndex = 53
