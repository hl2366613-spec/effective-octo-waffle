local hue = 0
local rainbowConn
rainbowConn = RunService.RenderStepped:Connect(function(delta)
    if not NotifyFrame or not NotifyFrame.Parent then
        rainbowConn:Disconnect()
        return
    end
    hue = (hue + delta * 0.4) % 1
    local color = Color3.fromHSV(hue, 0.8, 1)
    NotifyText.TextColor3 = color
    NFStroke.Color = color
end)

task.delay(6, function()
    if NotifyFrame and NotifyFrame.Parent then
        TweenService:Create(NotifyFrame, TweenInfo.new(1), {BackgroundTransparency = 1}):Play()
        TweenService:Create(NotifyText, TweenInfo.new(1), {TextTransparency = 1}):Play()
        local t = TweenService:Create(NFStroke, TweenInfo.new(1), {Transparency = 1})
        t:Play()
        t.Completed:Connect(function() NotifyFrame:Destroy() end)
    end
end)

