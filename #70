local currentAuraType = 1
local isFramAuraActive = false
local activeAuraEffectPart = nil

local auraNames = {
    "1. Hồng Hoa V4", "2. Băng Tuyết V4", "3. Sấm Sét V4", "4. Hỏa Diễm V4", 
    "5. Hắc Ám V4", "6. Kim Quang V4", "7. Thần Long V4", "8. Tinh Tú V4", 
    "9. Thiên Thần V4", "10. Cầu Vồng V4 (RGB)"
}

local function ClearAuraEffect()
    if activeAuraEffectPart then
        activeAuraEffectPart:Destroy()
        activeAuraEffectPart = nil
    end
end

local function ApplyAuraEffect(typeNum)
    ClearAuraEffect()
    if not isFramAuraActive then return end
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end

    local hrp = char.HumanoidRootPart
    local part = Instance.new("Part")
    part.Name = "AuraV4Visual"
    part.Size = Vector3.new(4, 6, 4)
    part.Transparency = 1
    part.CanCollide = false
    part.Anchored = false
    part.Parent = AuraFolder

    local weld = Instance.new("WeldConstraint")
    weld.Part0 = hrp
    weld.Part1 = part
    weld.Parent = part
    part.CFrame = hrp.CFrame

    local particles = Instance.new("ParticleEmitter")
    particles.Rate = 50
    particles.Speed = NumberRange.new(5, 10)
    particles.Size = NumberSequence.new({NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 3)})
    particles.Parent = part

    if typeNum == 1 then
        particles.Color = ColorSequence.new(Color3.fromRGB(255, 150, 180))
        particles.LightEmission = 0.8
    elseif typeNum == 2 then
        particles.Color = ColorSequence.new(Color3.fromRGB(150, 220, 255))
        particles.Texture = "rbxassetid://258123734"
    elseif typeNum == 3 then
        particles.Color = ColorSequence.new(Color3.fromRGB(255, 255, 100))
        particles.LightEmission = 1
    elseif typeNum == 4 then
        particles.Color = ColorSequence.new(Color3.fromRGB(255, 100, 50))
    elseif typeNum == 5 then
        particles.Color = ColorSequence.new(Color3.fromRGB(80, 40, 120))
    elseif typeNum == 6 then
        particles.Color = ColorSequence.new(Color3.fromRGB(255, 215, 0))
    elseif typeNum == 7 then
        particles.Color = ColorSequence.new(Color3.fromRGB(0, 255, 150))
    elseif typeNum == 8 then
        particles.Color = ColorSequence.new(Color3.fromRGB(180, 100, 255))
    elseif typeNum == 9 then
        particles.Color = ColorSequence.new(Color3.fromRGB(255, 255, 255))
    elseif typeNum == 10 then
        task.spawn(function()
            while part.Parent and isFramAuraActive do
                local hue = tick() % 5 / 5
                particles.Color = ColorSequence.new(Color3.fromHSV(hue, 1, 1))
                task.wait(0.1)
            end
        end)
    end
    activeAuraEffectPart = part
end

for i = 1, 10 do
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 26)
    btn.BackgroundColor3 = THEME.ButtonBg
    btn.Text = auraNames[i]
    btn.TextColor3 = THEME.TextDark
