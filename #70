-- Cột 1: Fly, Speed, Jump, Kill
local FlyBtn = CreateColButton(OtherCol1, "Fly: OFF")
local _, FlyMin, FlyPlus, FlyLabel = CreateAdjuster(OtherCol1, "Fly Speed", 1)
local flySpeed = 1
local isFlying = false
local bodyVel, bodyGyro

FlyMin.MouseButton1Click:Connect(function() flySpeed = math.max(1, flySpeed - 1) FlyLabel.Text = "Fly Speed: " .. flySpeed end)
FlyPlus.MouseButton1Click:Connect(function() flySpeed = flySpeed + 1 FlyLabel.Text = "Fly Speed: " .. flySpeed end)

FlyBtn.MouseButton1Click:Connect(function()
    isFlying = not isFlying
    FlyBtn.Text = isFlying and "🐾 Fly: BẬT" or "🐾 Fly: OFF"
    FlyBtn.TextColor3 = isFlying and THEME.Active or THEME.TextDark
    local char = LocalPlayer.Character
    if isFlying and char and char:FindFirstChild("HumanoidRootPart") then
        local hrp = char.HumanoidRootPart
        bodyVel = Instance.new("BodyVelocity")
        bodyVel.MaxForce = Vector3.new(1e9, 1e9, 1e9)
        bodyVel.Parent = hrp
        bodyGyro = Instance.new("BodyGyro")
        bodyGyro.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
        bodyGyro.Parent = hrp
        task.spawn(function()
            while isFlying do
                local camCF = Workspace.CurrentCamera.CFrame
                bodyGyro.CFrame = camCF
                bodyVel.Velocity = camCF.LookVector * (flySpeed * 40)
                task.wait()
            end
            if bodyVel then bodyVel:Destroy() end
            if bodyGyro then bodyGyro:Destroy() end
        end)
    end
end)

