-- ==================== LOGIC ÂM THANH HOÀN CHỈNH ====================

local localSound = Instance.new("Sound")
localSound.Name = "LocalMusicPlayer"
localSound.Parent = SoundService

local isPlayingMusic = false
local isLoopEnabled = _G.MusicLoopEnabled

local function UpdateAudioSettings()
    local vol = _G.MusicVolume / 100
    local spd = _G.MusicSpeed
    localSound.Volume = vol
    localSound.PlaybackSpeed = spd
    SaveSettings()
end

localSound.Ended:Connect(function()
    if isLoopEnabled and isPlayingMusic then
        localSound:Play()
    end
end)

task.spawn(function()
    while task.wait(0.3) do
        if isPlayingMusic and localSound.IsPlaying then
            local current = FormatTime(localSound.TimePosition)
            local total = FormatTime(localSound.TimeLength)
            MusicTimeLabel.Text = "Thời lượng: " .. current .. " / " .. total
        elseif not isPlayingMusic then
            MusicTimeLabel.Text = "Thời lượng: 00:00 / 00:00"
        end
    end
end)

local isDraggingSlider = false
local function UpdateSlider(input)
    local pos = math.clamp((input.Position.X - SliderBack.AbsolutePosition.X) / SliderBack.AbsoluteSize.X, 0, 1)
    _G.MusicVolume = math.floor(pos * 100)
    SliderFill.Size = UDim2.new(pos, 0, 1, 0)
    VolumeLabel.Text = "Âm lượng: " .. tostring(_G.MusicVolume)
    UpdateAudioSettings()
end

SliderBtn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        isDraggingSlider = true
        UpdateSlider(input)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if isDraggingSlider and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        UpdateSlider(input)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        isDraggingSlider = false
    end
end)

MusicSpeedMinusBtn.MouseButton1Click:Connect(function()
    if _G.MusicSpeed > 0.2 then
        _G.MusicSpeed = math.max(0.1, _G.MusicSpeed - 0.1)
        SpeedLabel.Text = "Tốc độ: " .. string.format("%.1f", _G.MusicSpeed)
        UpdateAudioSettings()
    end
end)

MusicSpeedPlusBtn.MouseButton1Click:Connect(function()
    if _G.MusicSpeed < 3.0 then
        _G.MusicSpeed = _G.MusicSpeed + 0.1
        SpeedLabel.Text = "Tốc độ: " .. string.format("%.1f", _G.MusicSpeed)
        UpdateAudioSettings()
    end
end)

MusicPlayBtn.MouseButton1Click:Connect(function()
    local id = MusicIDInput.Text:gsub("%D", "")
    if id == "" then return end

    isPlayingMusic = not isPlayingMusic
    if isPlayingMusic then
        local assetId = "rbxassetid://" .. id
        localSound.SoundId = assetId
        UpdateAudioSettings()
        localSound:Play()

        MusicPlayBtn.Text = "stoping"
        MusicPlayBtn.TextColor3 = THEME.Inactive

        task.spawn(function()
            local success, info = pcall(function()
                return game:GetService("MarketplaceService"):GetProductInfo(tonumber(id), Enum.InfoType.Asset)
            end)
            if success and info then
                MusicInfoLabel.Text = "Nhạc: " .. tostring(info.Name)
            else
                MusicInfoLabel.Text = "Nhạc ID: " .. id
            end
        end)
    else
        localSound:Stop()
        MusicPlayBtn.Text = "playing"
        MusicPlayBtn.TextColor3 = THEME.Active
        MusicInfoLabel.Text = "Chưa chọn nhạc"
    end
end)

