local currentAuraIndex = 1
local isFramAuraActive = false
local currentParticle = nil

local auraColors = {
    Color3.fromRGB(255, 100, 150), -- 1. Hồng
    Color3.fromRGB(100, 200, 255), -- 2. Băng
    Color3.fromRGB(255, 230, 80),  -- 3. Sấm
    Color3.fromRGB(255, 80, 40),   -- 4. Lửa
    Color3.fromRGB(130, 50, 200),  -- 5. Hắc Ám
    Color3.fromRGB(255, 215, 0),   -- 6. Hoàng Kim
    Color3.fromRGB(50, 255, 150),  -- 7. Lục Bảo
    Color3.fromRGB(200, 150, 255), -- 8. Tinh Tú
    Color3.fromRGB(255, 255, 255), -- 9. Bạch Kim
    Color3.fromRGB(255, 0, 0)      -- 10. RGB Cầu Vồng
}

local function UpdateAura()
    AuraFolder:ClearAllChildren()
    if not isFramAuraActive then return end
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end

    local p = Instance.new("ParticleEmitter")
    p.Rate = 45
    p.Speed = NumberRange.new(4, 8)
    p.Size = NumberSequence.new({NumberSequenceKeypoint.new(0, 1.5), NumberSequenceKeypoint.new(1, 0)})
    p.Texture = "rbxassetid://243660364"
    p.Parent = char.HumanoidRootPart

    if currentAuraIndex == 10 then
        task.spawn(function()
            while isFramAuraActive and p.Parent do
                local hue = tick() % 5 / 5
                p.Color = ColorSequence.new(Color3.fromHSV(hue, 1, 1))
                task.wait(0.1)
            end
        end)
    else
        p.Color = ColorSequence.new(auraColors[currentAuraIndex])
    end
end

for i = 1, 10 do
    local aBtn = Instance.new("TextButton")
    aBtn.Size = UDim2.new(1, 0, 0, 25)
    aBtn.BackgroundColor3 = THEME.ButtonBg
    aBtn.Text = "Aura " .. i .. (i == 10 and " (RGB)" or "")
    aBtn.TextColor3 = THEME.TextDark
    aBtn.Font = Enum.Font.FredokaOne
    aBtn.TextSize = 10
    aBtn.Parent = AuraListScroll
    CreateCorner(aBtn, 6)

    aBtn.MouseButton1Click:Connect(function()
        currentAuraIndex = i
        SelectAuraBtn.Text = "Aura " .. i
        AuraListFrame.Visible = false
        UpdateAura()
    end)
end

FramAuraBtn.MouseButton1Click:Connect(function()
    isFramAuraActive = not isFramAuraActive
    FramAuraBtn.Text = isFramAuraActive and "Fram Aura: BẬT" or "Fram Aura: TẮT"
    FramAuraBtn.TextColor3 = isFramAuraActive and THEME.Active or THEME.Inactive
    UpdateAura()
end)

