--// UTILITY
local function corner(obj, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius or 10)
    c.Parent = obj
    return c
end

local function stroke(obj, thickness)
    local s = Instance.new("UIStroke")
    s.Thickness = thickness or 1
    s.Transparency = 0
    s.Parent = obj
    return s
end

local function padding(obj, value)
    local p = Instance.new("UIPadding")
    p.PaddingTop = UDim.new(0,value)
    p.PaddingBottom = UDim.new(0,value)
    p.PaddingLeft = UDim.new(0,value)
    p.PaddingRight = UDim.new(0,value)
    p.Parent = obj
end

local function makeText(parent, text, size, bold)
    local t = Instance.new("TextLabel")
    t.BackgroundTransparency = 1
    t.Text = text
    t.TextColor3 = TEXT
    t.TextSize = size or 14
    t.Font = bold and Enum.Font.GothamBold or Enum.Font.Gotham
    t.TextXAlignment = Enum.TextXAlignment.Left
    t.Parent = parent
    return t
end

