--// REAL VIETNAM TIME
local function vietnamTime()
    local utc = os.time(os.date("!*t"))
    local vn = utc + (7*60*60)
    return os.date("!%H:%M:%S",vn)
end

--// PING + TIME
task.spawn(function()
    while Gui.Parent do
        local ping = "--"

        pcall(function()
            local network = Stats.Network
            local serverStats = network.ServerStatsItem
            local pingItem = serverStats["Data Ping"]
            ping = math.floor(pingItem:GetValue())
        end)

        PingText.Text = "PING: "..tostring(ping).." ms"
        TimeText.Text = "VN: "..vietnamTime()

        task.wait(1)
    end
end)

