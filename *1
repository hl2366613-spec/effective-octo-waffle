local function toggleButton(name)
    local state = false

    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1,0,0,44)
    b.BackgroundColor3 = CARD
    b.BackgroundTransparency = 0.12
    b.Text = "  " .. name
    b.TextColor3 = TEXT
    b.TextSize = 12
    b.Font = Enum.Font.GothamMedium
    b.TextXAlignment = Enum.TextXAlignment.Left
    b.Parent = HomePage
    corner(b,11)

    local s = stroke(b,1)
    s.Transparency = 0.65

    local indicator = Instance.new("TextLabel")
    indicator.Size = UDim2.new(0,55,0,25)
    indicator.Position = UDim2.new(1,-65,0.5,-12)
    indicator.BackgroundColor3 = Color3.fromRGB(45,45,55)
    indicator.Text = "OFF"
    indicator.TextColor3 = SUBTEXT
    indicator.TextSize = 10
    indicator.Font = Enum.Font.GothamBold
    indicator.Parent = b
    corner(indicator,8)

    b.MouseButton1Click:Connect(function()
        state = not state

        if state then
            indicator.Text = "ON"
            indicator.TextColor3 = Color3.fromRGB(255,255,255)
            indicator.BackgroundColor3 = Color3.fromRGB(70,70,85)
        else
            indicator.Text = "OFF"
            indicator.TextColor3 = SUBTEXT
            indicator.BackgroundColor3 = Color3.fromRGB(45,45,55)
        end
    end)

    return b
end

