local currentFunc = nil

-- Hàm tạo nút
local function CreateButton(name, type, callback)
    local btn = Instance.new("TextButton", Scroll)
    btn.Size = UDim2.new(1, 0, 0, 35)
    btn.BackgroundColor3 = Color3.fromRGB(35, 37, 45)
    btn.Text = name
    btn.TextColor3 = Color3.new(1,1,1)
    Instance.new("UICorner", btn)
    
    btn.MouseButton1Click:Connect(function()
        if type == "Adjust" then
            AdjustFrame.Visible = true
            currentFunc = callback
        elseif type == "Player" then
            PlayerFrame.Visible = true
            -- Load list players
            for _, c in pairs(PlayerScroll:GetChildren()) do if not c:IsA("UIListLayout") then c:Destroy() end end
            for _, p in pairs(Players:GetPlayers()) do
                local pBtn = Instance.new("TextButton", PlayerScroll)
                pBtn.Size = UDim2.new(1, 0, 0, 30)
                pBtn.Text = p.Name
                pBtn.MouseButton1Click:Connect(function()
                    callback(p) -- Chạy ngay khi bấm (không xác nhận)
                    PlayerFrame.Visible = false
                end)
            end
        else
            callback()
        end
    end)
end

-- Chức năng
ConfirmBtn.MouseButton1Click:Connect(function()
