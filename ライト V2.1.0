-- Hàm tạo nút nhỏ đơn
local function CreateSmallButton(parent, text)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 28)
    btn.BackgroundColor3 = Color3.fromRGB(30, 20, 40)
    btn.BackgroundTransparency = 0.35
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(255, 100, 100)
    btn.TextSize = 11
    btn.Font = Enum.Font.SourceSansBold
    btn.Parent = parent
    CreateCorner(btn, 6)
    
    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(60, 40, 80)
    stroke.Thickness = 1
    stroke.Parent = btn
    
    return btn
end

-- Hàm tạo hàng chỉnh có nút
local function CreateAdjustRow(parent, title, defaultValue)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, 0, 0, 28)
    row.BackgroundTransparency = 1
    row.Parent = parent

    local toggle = Instance.new("TextButton")
    toggle.Size = UDim2.new(0.35, 0, 1, 0)
    toggle.Position = UDim2.new(0, 0, 0, 0)
    toggle.BackgroundColor3 = Color3.fromRGB(30, 20, 40)
    toggle.BackgroundTransparency = 0.35
    toggle.Text = title .. ": OFF"
    toggle.TextColor3 = Color3.fromRGB(255, 100, 100)
    toggle.TextSize = 10
    toggle.Font = Enum.Font.SourceSansBold
    toggle.Parent = row
    CreateCorner(toggle, 6)

    local minus = Instance.new("TextButton")
    minus.Size = UDim2.new(0.15, 0, 1, 0)
    minus.Position = UDim2.new(0.38, 0, 0, 0)
    minus.BackgroundColor3 = Color3.fromRGB(30, 20, 40)
    minus.BackgroundTransparency = 0.35
    minus.Text = "-"
    minus.TextColor3 = Color3.fromRGB(200, 200, 255)
    minus.TextSize = 14
    minus.Font = Enum.Font.SourceSansBold
    minus.Parent = row
    CreateCorner(minus, 6)

    local valueLabel = Instance.new("TextLabel")
    valueLabel.Size = UDim2.new(0.15, 0, 1, 0)
    valueLabel.Position = UDim2.new(0.56, 0, 0, 0)
    valueLabel.BackgroundColor3 = Color3.fromRGB(15, 10, 20)
    valueLabel.BackgroundTransparency = 0.35
    valueLabel.Text = tostring(defaultValue)
    valueLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    valueLabel.TextSize = 12
    valueLabel.Font = Enum.Font.SourceSansBold
    valueLabel.Parent = row
    CreateCorner(valueLabel, 6)

    local plus = Instance.new("TextButton")
    plus.Size = UDim2.new(0.15, 0, 1, 0)
    plus.Position = UDim2.new(0.74, 0, 0, 0)
    plus.BackgroundColor3 = Color3.fromRGB(30, 20, 40)
    plus.BackgroundTransparency = 0.35
    plus.Text = "+"
    plus.TextColor3 = Color3.fromRGB(200, 200, 255)
    plus.TextSize = 14
    plus.Font = Enum.Font.SourceSansBold
    plus.Parent = row
    CreateCorner(plus, 6)

    return row, toggle, minus, valueLabel, plus
end

