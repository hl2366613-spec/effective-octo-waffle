--[[ 
    DELTA EXECUTOR SCRIPT - SHARK V4 & T-REX CLAWS
    Tác giả: Custom Script
    Tính năng: Menu 3x3, Hào quang, Móng vuốt T-Rex, Chém 3 block, Sát thương chuẩn Server.
--]]

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoidRootPart = character:WaitForChild("HumanoidRootPart")

-- === CẤU HÌNH ===
local IMAGE_ID = "rbxassetid://108332620971864"
local ATTACK_RANGE = 3
local DAMAGE = 50
local IS_ON = false
local COOLDOWN = 0.5 -- Giảm hồi chiêu để đánh nhanh hơn
local canAttack = true

-- === 1. TẠO GIAO DIỆN MENU 3x3 ===
local screenGui = Instance.new("ScreenGui")
