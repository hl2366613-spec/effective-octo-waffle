closeBtn.MouseButton1Click:Connect(toggleMenu)
refreshBtn.MouseButton1Click:Connect(updatePlayerList)

stopBtn.MouseButton1Click:Connect(function()
    if isRiding then stopRiding() end
end)

-- Phím tắt "G" để mở menu
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.G then toggleMenu() end
end)

-- Xử lý khi nhân vật mới xuất hiện (hồi sinh)
player.CharacterAdded:Connect(function(newChar)
    character = newChar
    humanoid = character:WaitForChild("Humanoid")
    stopRiding()
end)

-- Xử lý khi nhân vật chết
humanoid.StateChanged:Connect(function(oldState, newState)
    if newState == Enum.HumanoidStateType.Dead then stopRiding() end
end)

-- Cập nhật danh sách khi có người chơi mới vào
Players.PlayerAdded:Connect(function()
    if menuVisible then updatePlayerList() end
end)
Players.PlayerRemoving:Connect(function()
    if menuVisible then updatePlayerList() end
end)

