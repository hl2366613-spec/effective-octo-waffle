-- // ========== CÁC HÀM CHỨC NĂNG ==========

-- Hàm cập nhật danh sách người chơi
local function updatePlayerList()
    for _, child in pairs(playerListFrame:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end

    local yOffset = 0
    for _, otherPlayer in ipairs(Players:GetPlayers()) do
        if otherPlayer ~= player then
            local otherChar = otherPlayer.Character
            local isAlive = otherChar and otherChar:FindFirstChildOfClass("Humanoid") and otherChar.Humanoid.Health > 0

            local playerBtn = Instance.new("TextButton")
            playerBtn.Size = UDim2.new(1, -10, 0, 35)
            playerBtn.Position = UDim2.new(0, 5, 0, yOffset)
            playerBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 70)
            playerBtn.BackgroundTransparency = 0.3
            playerBtn.BorderSizePixel = 0
            playerBtn.Text = otherPlayer.Name .. (isAlive and " ✅" or " ❌")
            playerBtn.TextColor3 = isAlive and Color3.fromRGB(100, 255, 100) or Color3.fromRGB(255, 100, 100)
            playerBtn.TextSize = 14
            playerBtn.Font = Enum.Font.Gotham
            playerBtn.TextXAlignment = Enum.TextXAlignment.Left
            playerBtn.Parent = playerListFrame
            Instance.new("UICorner", playerBtn).CornerRadius = UDim.new(0, 4)
            
            -- Padding cho text
            local padding = Instance.new("UIPadding")
            padding.PaddingLeft = UDim.new(0, 10)
            padding.Parent = playerBtn

            -- Sự kiện click để ngồi lên đầu
            playerBtn.MouseButton1Click:Connect(function()
                if not isAlive then return end
                rideOnHead(otherPlayer)
                updatePlayerList()
            end)
            yOffset = yOffset + 40
        end
    end
    playerListFrame.CanvasSize = UDim2.new(0, 0, 0, math.max(yOffset + 10, 220))
end

-- Hàm ngồi lên đầu
local function rideOnHead(target)
    if not target or not target.Character then return end
    if isRiding then stopRiding() end

    local targetChar = target.Character
    local head = targetChar:FindFirstChild("Head")
    if not head then return end

    isRiding = true
    targetPlayer = target
    local heightOffset = tonumber(heightSlider.Text) or 2.5

    character.HumanoidRootPart.CanCollide = false
    humanoid.Sit = true
    humanoid.AutoRotate = false

    if rideConnection then rideConnection:Disconnect() end
    rideConnection = RunService.Heartbeat:Connect(function()
        if not isRiding or not target or not target.Character then
            stopRiding()
            return
        end
        local targetHead = target.Character:FindFirstChild("Head")
        if targetHead then
            local targetPos = targetHead.Position + Vector3.new(0, heightOffset, 0)
            character:SetPrimaryPartCFrame(CFrame.new(targetPos))
        end
    end)

    stopBtn.Text = "⬇️ Đang ngồi..."
    stopBtn.BackgroundColor3 = Color3.fromRGB(100, 200, 100)
end

-- Hàm dừng ngồi
local function stopRiding()
    isRiding = false
    targetPlayer = nil
    if character then
        character.HumanoidRootPart.CanCollide = true
        humanoid.Sit = false
        humanoid.AutoRotate = true
    end
    if rideConnection then
        rideConnection:Disconnect()
        rideConnection = nil
    end
    stopBtn.Text = "⬇️ Xuống"
    stopBtn.BackgroundColor3 = Color3.fromRGB(200, 60, 60)
    updatePlayerList()
end

-- Hàm mở/đóng menu
local function toggleMenu()
    menuVisible = not menuVisible
    mainFrame.Visible = menuVisible
    if menuVisible then updatePlayerList() end
end

-- // ========== GÁN SỰ KIỆN CHO CÁC NÚT ==========
