-- ===== HÀM TẠO NÚT =====
local function createButton(text, callback, color, size)
    local btn = Instance.new("TextButton")
    btn.Size = size or UDim2.new(1, -10, 0, 32)
    btn.Position = UDim2.new(0, 5, 0, 0)
    btn.BackgroundColor3 = Color3.fromRGB(22, 22, 30)
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(230, 230, 230)
    btn.TextScaled = true
    btn.Font = Enum.Font.Gotham
    btn.BorderSizePixel = 0
    btn.BackgroundTransparency = 0
    btn.ZIndex = 12
    btn.AutoButtonColor = false
    
    local border = Instance.new("Frame")
    border.Size = UDim2.new(1, 0, 1, 0)
    border.Position = UDim2.new(0, 0, 0, 0)
    border.BackgroundColor3 = color or Color3.fromRGB(0, 100, 200)
    border.BackgroundTransparency = 0.5
    border.BorderSizePixel = 0
    border.ZIndex = 11
    border.Parent = btn
    
    btn.MouseButton1Click:Connect(function()
        callback()
        resetTimer()
    end)
    btn.TouchTap:Connect(function()
        callback()
        resetTimer()
    end)
    
    return btn
end

-- ===== HÀM TẠO SLIDER =====
local function createSlider(label, min, max, default, callback)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, -10, 0, 45)
    frame.BackgroundTransparency = 1
    frame.ZIndex = 12
    
    local labelText = Instance.new("TextLabel")
    labelText.Size = UDim2.new(0.4, 0, 1, 0)
    labelText.Position = UDim2.new(0, 0, 0, 0)
    labelText.BackgroundTransparency = 1
    labelText.Text = label
    labelText.TextColor3 = Color3.fromRGB(200, 200, 200)
    labelText.TextScaled = true
    labelText.Font = Enum.Font.Gotham
    labelText.ZIndex = 13
    labelText.Parent = frame
    
    local valueText = Instance.new("TextLabel")
    valueText.Size = UDim2.new(0.15, 0, 1, 0)
    valueText.Position = UDim2.new(0.85, 0, 0, 0)
    valueText.BackgroundTransparency = 1
    valueText.Text = tostring(default)
    valueText.TextColor3 = Color3.fromRGB(0, 200, 255)
    valueText.TextScaled = true
    valueText.Font = Enum.Font.Gotham
    valueText.ZIndex = 13
    valueText.Parent = frame
    
    local slider = Instance.new("Frame")
    slider.Size = UDim2.new(0.35, 0, 0.5, 0)
    slider.Position = UDim2.new(0.45, 0, 0.25, 0)
    slider.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
    slider.BackgroundTransparency = 0
    slider.BorderSizePixel = 0
    slider.ZIndex = 13
    slider.Parent = frame
    
    local fill = Instance.new("Frame")
    fill.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
    fill.Position = UDim2.new(0, 0, 0, 0)
    fill.BackgroundColor3 = Color3.fromRGB(0, 150, 255)
    fill.BackgroundTransparency = 0
    fill.BorderSizePixel = 0
    fill.ZIndex = 14
    fill.Parent = slider
    
    local dragging = false
    local currentValue = default
    
    slider.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
        end
    end)
    
    slider.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    
    slider.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local pos = input.Position.X - slider.AbsolutePosition.X
            local percent = math.clamp(pos / slider.AbsoluteSize.X, 0, 1)
            currentValue = math.floor(min + (max - min) * percent)
            fill.Size = UDim2.new(percent, 0, 1, 0)
            valueText.Text = tostring(currentValue)
            callback(currentValue)
        end
    end)
    
    return frame
end

-- ===== CÁC CHỨC NĂNG =====

-- FLY
local flyConn
local function toggleFly()
    flyEnabled = not flyEnabled
    if flyEnabled then
        local bodyVelocity = Instance.new("BodyVelocity")
        bodyVelocity.MaxForce = Vector3.new(1,1,1) * 1e9
        bodyVelocity.Velocity = Vector3.new(0,0,0)
        bodyVelocity.Parent = hrp or char

        flyConn = RunService.Heartbeat:Connect(function()
            if not flyEnabled or not hrp then return end
            local moveDir = Vector3.new()
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + hrp.CFrame.LookVector * flySpeed end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - hrp.CFrame.LookVector * flySpeed end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - hrp.CFrame.RightVector * flySpeed end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + hrp.CFrame.RightVector * flySpeed end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveDir = moveDir + Vector3.new(0, flySpeed, 0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then moveDir = moveDir - Vector3.new(0, flySpeed, 0) end
            hrp.Velocity = moveDir
        end)
    else
        if flyConn then flyConn:Disconnect() end
        if hrp then hrp.Velocity = Vector3.new(0,0,0) end
    end
end

-- NOCLIP
local noclipConn
local function toggleNoclip()
    noclipEnabled = not noclipEnabled
    if noclipEnabled then
        noclipConn = RunService.Heartbeat:Connect(function()
            if not noclipEnabled or not char then return end
            for _, part in pairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end
        end)
    else
        if noclipConn then noclipConn:Disconnect() end
        if char then
            for _, part in pairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = true
                end
            end
        end
    end
end

-- INFINITE JUMP
local jumpConn
local function toggleInfiniteJump()
    infiniteJumpEnabled = not infiniteJumpEnabled
    if infiniteJumpEnabled then
        jumpConn = UserInputService.JumpRequest:Connect(function()
            if char and char:FindFirstChild("Humanoid") then
                char.Humanoid.Jump = true
            end
        end)
    else
        if jumpConn then jumpConn:Disconnect() end
    end
end

-- ESP
local espConn
local function toggleESP()
    espEnabled = not espEnabled
    if espEnabled then
        espConn = RunService.Heartbeat:Connect(function()
            for _, plr in pairs(Players:GetPlayers()) do
                if plr ~= player and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                    local root = plr.Character.HumanoidRootPart
                    local pos, onScreen = camera:WorldToViewportPoint(root.Position)
                    
                    if onScreen then
                        if not espObjects[plr] then
                            local espBox = Instance.new("Frame")
                            espBox.Size = UDim2.new(0, 40, 0, 80)
                            espBox.Position = UDim2.new(0, pos.X - 20, 0, pos.Y - 40)
                            espBox.BackgroundColor3 = Color3.fromRGB(0, 255, 255)
                            espBox.BackgroundTransparency = 0.3
                            espBox.BorderSizePixel = 0
                            espBox.ZIndex = 5
                            espBox.Parent = screenGui

                            local espName = Instance.new("TextLabel")
                            espName.Size = UDim2.new(1, 0, 0, 20)
                            espName.Position = UDim2.new(0, 0, 1, 0)
                            espName.BackgroundTransparency = 1
                            espName.Text = plr.Name
                            espName.TextColor3 = Color3.fromRGB(255, 255, 255)
                            espName.TextScaled = true
                            espName.Font = Enum.Font.GothamBold
                            espName.ZIndex = 6
                            espName.Parent = espBox

                            espObjects[plr] = espBox
                        else
                            local espBox = espObjects[plr]
                            espBox.Position = UDim2.new(0, pos.X - 20, 0, pos.Y - 40)
                        end
                    else
                        if espObjects[plr] then
                            espObjects[plr]:Destroy()
                            espObjects[plr] = nil
                        end
                    end
                end
            end
        end)
    else
        if espConn then espConn:Disconnect() end
        for _, obj in pairs(espObjects) do
            obj:Destroy()
        end
        espObjects = {}
    end
end

-- FULLBRIGHT
local function toggleFullbright()
    fullbrightEnabled = not fullbrightEnabled
    if fullbrightEnabled then
        for _, light in pairs(workspace:GetDescendants()) do
            if light:IsA("Light") then
                light.Enabled = true
                light.Brightness = 10
            end
        end
        workspace.CurrentCamera.Brightness = 10
    else
        for _, light in pairs(workspace:GetDescendants()) do
            if light:IsA("Light") then
                light.Brightness = 1
            end
        end
        workspace.CurrentCamera.Brightness = 1
    end
end

