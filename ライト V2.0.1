        configLabel.Text = "💾 Save / Load Config"
        configLabel.TextColor3 = Color3.fromRGB(0, 200, 255)
        configLabel.TextScaled = true
        configLabel.Font = Enum.Font.GothamBold
        configLabel.ZIndex = 12
        configLabel.LayoutOrder = order
        configLabel.Parent = contentFrame
        order = order + 1
        
        local configs = {"Save", "Load", "Reset"}
        for _, config in ipairs(configs) do
            local btn = createButton(config, function()
                print(config .. " config")
            end, Color3.fromRGB(200, 200, 100))
            btn.LayoutOrder = order
            btn.Parent = contentFrame
            order = order + 1
        end
    end
    
    contentFrame.CanvasSize = UDim2.new(0, 0, 0, order * 38 + 20)
end

