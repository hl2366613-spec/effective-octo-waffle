-- 3. LOGIC XỬ LÝ SỰ KIỆN
--------------------------------------------------------------------------------
local selectedPlayer = nil
local activeCallback = nil
local buttonOrder = 1

local function CreateMainButton(btnText, mode, callback)
    local btn = Instance.new("TextButton", MainFrame)
    btn.Size = UDim2.new(0.85, 0, 0, 35)
    btn.BackgroundColor3 = Color3.fromRGB(35, 37, 45)
    btn.Text = btnText
    btn.TextColor3 = Color3.new(1, 1, 1)
    btn.Font = Enum.Font.Gotham
    btn.LayoutOrder = buttonOrder
    buttonOrder = buttonOrder + 1
    Instance.new("UICorner", btn)

    btn.MouseButton1Click:Connect(function()
        SubFrame.Visible = true
        SubTitle.Text = btnText
        activeCallback = callback
        selectedPlayer = nil

        if mode == "Input" then
            InputBox.Visible = true
            PlayerScroll.Visible = false
            InputBox.Text = ""
        elseif mode == "Player" then
            InputBox.Visible = false
            PlayerScroll.Visible = true
            
            -- Cập nhật danh sách người chơi
            for _, child in pairs(PlayerScroll:GetChildren()) do
                if not child:IsA("UIListLayout") then child:Destroy() end
            end

            for _, p in pairs(Players:GetPlayers()) do
                if p ~= LocalPlayer then
                    local pBtn = Instance.new("TextButton", PlayerScroll)
                    pBtn.Size = UDim2.new(1, 0, 0, 28)
                    pBtn.BackgroundColor3 = Color3.fromRGB(45, 47, 55)
                    pBtn.Text = p.DisplayName .. " (@" .. p.Name .. ")"
                    pBtn.TextColor3 = Color3.new(1, 1, 1)
                    pBtn.Font = Enum.Font.Gotham
                    pBtn.TextSize = 11
                    Instance.new("UICorner", pBtn)

                    pBtn.MouseButton1Click:Connect(function()
                        selectedPlayer = p
                        for _, item in pairs(PlayerScroll:GetChildren()) do
                            if item:IsA("TextButton") then
                                item.BackgroundColor3 = Color3.fromRGB(45, 47, 55)
                            end
                        end
                        pBtn.BackgroundColor3 = Color3.fromRGB(255, 200, 50)
                        pBtn.TextColor3 = Color3.fromRGB(20, 20, 20)
                    end)
                end
            end
        end
    end)
end

-- Xử lý bấm nút XÁC NHẬN
ConfirmBtn.MouseButton1Click:Connect(function()
    if activeCallback then
        if InputBox.Visible then
            local numVal = tonumber(InputBox.Text)
            if numVal then activeCallback(numVal) end
        elseif PlayerScroll.Visible then
            if selectedPlayer then activeCallback(selectedPlayer) end
        end
    end
end)

