task.spawn(function()
    while task.wait(0.1) do
        if isFramAuraActive and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            local hrp = LocalPlayer.Character.HumanoidRootPart
            local p = Instance.new("Part", AuraFolder)
            p.Shape = Enum.PartType.Ball
            p.Size = Vector3.new(2, 2, 2)
            p.Position = hrp.Position + Vector3.new(math.random(-3,3), math.random(-1,2), math.random(-3,3))
            p.Anchored = true
            p.CanCollide = false
            p.Material = Enum.Material.Neon
            
            -- Phân loại màu sắc theo 10 loại độc quyền
            if currentAuraType == 1 then
                p.Color = Color3.fromRGB(255, 150, 180) -- Hồng đào
            elseif currentAuraType == 2 then
                p.Color = Color3.fromRGB(100, 200, 255) -- Lôi điện
            elseif currentAuraType == 3 then
                p.Color = Color3.fromRGB(50, 50, 50)   -- Hắc hỏa
            elseif currentAuraType == 4 then
                p.Color = Color3.fromRGB(200, 240, 255) -- Băng sương
            elseif currentAuraType == 5 then
                p.Color = Color3.fromRGB(255, 215, 0)   -- Kim long
            elseif currentAuraType == 6 then
                p.Color = Color3.fromRGB(138, 43, 226)  -- Ngân hà
            elseif currentAuraType == 7 then
                p.Color = Color3.fromRGB(255, 192, 203) -- Anh đào
            elseif currentAuraType == 8 then
                p.Color = Color3.fromRGB(178, 34, 34)   -- Huyết nguyệt
            elseif currentAuraType == 9 then
                p.Color = Color3.fromRGB(255, 105, 180) -- Cầu vồng hồng
            elseif currentAuraType == 10 then
                -- Đổi màu liên tục cực đẹp
                p.Color = Color3.fromHSV(tick() % 5 / 5, 1, 1)
            end

            TweenService:Create(p, TweenInfo.new(0.6), {Size = Vector3.new(0.1, 0.1, 0.1), Transparency = 1}):Play()
            game:GetService("Debris"):AddItem(p, 0.6)
        end
    end
end)

