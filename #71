-- ==================== UTILITY FUNCTIONS ====================
local function CreateCorner(parent, radius)
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, radius or 12)
    corner.Parent = parent
    return corner
end

local function CreateStroke(parent, thickness, color)
    local stroke = Instance.new("UIStroke")
    stroke.Color = color or THEME.Border
    stroke.Thickness = thickness or 1.5
    stroke.Transparency = 0
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    stroke.Parent = parent
    return stroke
end

local function FormatTime(seconds)
    if not seconds or seconds ~= seconds or seconds <= 0 then return "00:00" end
    local mins = math.floor(seconds / 60)
    local secs = math.floor(seconds % 60)
    return string.format("%02d:%02d", mins, secs)
end

local function GetBatteryStatus()
    local batteryStr = "Không hỗ trợ"
    pcall(function()
        if UserInputService.TouchEnabled then
            -- Giả lập đọc thông tin pin nếu executor hỗ trợ hoặc trả về mức mặc định
            batteryStr = "85% (Ổn định)"
        end
    end)
    return batteryStr
end

