    end
    for i, noteText in ipairs(notesList) do
        local f = Instance.new("Frame", NotesScroll)
        f.Size = UDim2.new(1, -4, 0, 45)
        f.BackgroundColor3 = THEME.ContainerBg
        CreateCorner(f, 6)
        CreateStroke(f, 1, THEME.Border)

        local lbl = Instance.new("TextLabel", f)
        lbl.Size = UDim2.new(1, -65, 1, 0)
        lbl.Position = UDim2.new(0, 5, 0, 0)
        lbl.BackgroundTransparency = 1
        lbl.Text = noteText
        lbl.TextColor3 = THEME.TextDark
        lbl.TextSize = 11
        lbl.Font = Enum.Font.FredokaOne
        lbl.TextWrapped = true
        lbl.TextXAlignment = Enum.TextXAlignment.Left

        local copyBtn = Instance.new("TextButton", f)
        copyBtn.Size = UDim2.new(0, 28, 0, 20)
        copyBtn.Position = UDim2.new(1, -60, 0, 12)
        copyBtn.BackgroundColor3 = THEME.ButtonBg
        copyBtn.Text = "📋"
        copyBtn.TextSize = 10
        CreateCorner(copyBtn, 4)
        copyBtn.MouseButton1Click:Connect(function()
            pcall(function() setclipboard(noteText) end)
        end)

        local delBtn = Instance.new("TextButton", f)
        delBtn.Size = UDim2.new(0, 28, 0, 20)
        delBtn.Position = UDim2.new(1, -28, 0, 12)
        delBtn.BackgroundColor3 = THEME.ButtonBg
        delBtn.Text = "❌"
        delBtn.TextSize = 10
        CreateCorner(delBtn, 4)
        delBtn.MouseButton1Click:Connect(function()
            table.remove(notesList, i)
            RefreshNotes()
        end)
    end
    NotesScroll.CanvasSize = UDim2.new(0, 0, 0, #notesList * 50)
end

