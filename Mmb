function showPlayerList()
    for _, child in ipairs(playerScroll:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player then
            local btn = Instance.new("TextButton")
            btn.Size = UDim2.new(1, -10, 0, 30)
            btn.BackgroundColor3 = Color3.new(0.2, 0.2, 0.25)
            btn.Text = plr.Name
            btn.TextColor3 = Color3.new(1, 1, 1)
            btn.TextSize = 14
            btn.Font = Enum.Font.Gotham
            btn.BorderSizePixel = 0
            btn.Parent = playerScroll
            btn.AutoButtonColor = true
            local btnCorner = Instance.new("UICorner")
            btnCorner.CornerRadius = UDim2.new(0, 4, 0, 4)
            btnCorner.Parent = btn
            btn.MouseButton1Click:Connect(function()
                selectedPlayer = plr
                playerListFrame.Visible = false
                selectPlayerBtn.Text = "Selected: " .. plr.Name
                if followPlayer then startFollowing() end
            end)
            btn.TouchTap:Connect(function() btn.MouseButton1Click:Fire() end)
        end
    end
    playerListFrame.Visible = true
end

