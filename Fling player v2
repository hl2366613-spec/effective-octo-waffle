-- Toggle button
toggleButton.MouseButton1Click:Connect(function()
    isFlingEnabled = not isFlingEnabled
    updateToggleButton()
    
    if isFlingEnabled then
        if not targetPlayer then
            statusLabel.Text = "⚠️ Chọn người chơi trước!"
            statusLabel.TextColor3 = Color3.fromRGB(255, 200, 0)
            isFlingEnabled = false
            updateToggleButton()
            return
        end
        
        statusLabel.Text = "🟢 Đã bật"
        statusLabel.TextColor3 = Color3.fromRGB(0, 255, 0)
        
        if flingCoroutine then
            coroutine.close(flingCoroutine)
        end
        
        flingCoroutine = coroutine.create(function()
            while isFlingEnabled do
                if targetPlayer then
                    local success = flingTarget(targetPlayer)
                    if not success then
                        -- Tìm player khác
                        for _, p in pairs(game.Players:GetPlayers()) do
                            if p ~= player and p.Character then
                                targetPlayer = p
                                targetDisplay.Text = "🎯 " .. p.Name
                                statusLabel.Text = "🔄 Chuyển sang: " .. p.Name
                                break
                            end
                        end
                    end
                end
                task.wait(5)
            end
        end)
        
        coroutine.resume(flingCoroutine)
        
    else
        statusLabel.Text = "🔴 Đã tắt"
        statusLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
        isFlinging = false
        
        if flingCoroutine then
            coroutine.close(flingCoroutine)
            flingCoroutine = nil
        end
        
        -- Phục hồi tàng hình
        humanoid.Health = 100
        character:SetAttribute("Flinging", false)
    end
end)

