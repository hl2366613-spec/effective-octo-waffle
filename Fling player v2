-- Function cập nhật toggle
local function updateToggleButton()
    if isFlingEnabled then
        toggleButton.Text = "ON"
        toggleButton.BackgroundColor3 = Color3.fromRGB(0, 200, 50)
    else
        toggleButton.Text = "OFF"
        toggleButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    end
end

-- Function cập nhật danh sách player
local function updatePlayerList()
    for _, child in pairs(playerList:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end
    
    local players = game.Players:GetPlayers()
    local yPos = 0
    
    for _, p in pairs(players) do
        if p ~= player then
            local btn = Instance.new("TextButton")
            btn.Size = UDim2.new(1, 0, 0, 28)
            btn.Position = UDim2.new(0, 0, 0, yPos)
            btn.Text = p.Name
            btn.TextColor3 = Color3.fromRGB(200, 220, 255)
            btn.BackgroundColor3 = Color3.fromRGB(20, 20, 35)
            btn.Font = Enum.Font.Gotham
            btn.TextSize = 13
            btn.Parent = playerList
            
            local btnCorner = Instance.new("UICorner")
            btnCorner.CornerRadius = UDim.new(0, 3)
            btnCorner.Parent = btn
            
            btn.MouseButton1Click:Connect(function()
                targetPlayer = p
                targetDisplay.Text = "🎯 " .. p.Name
                targetDisplay.TextColor3 = Color3.fromRGB(0, 255, 200)
                statusLabel.Text = "✅ Đã chọn: " .. p.Name
                statusLabel.TextColor3 = Color3.fromRGB(0, 255, 150)
                selectMenu.Visible = false
                isChoosingPlayer = false
            end)
            
            -- Hover effect
            btn.MouseEnter:Connect(function()
                btn.BackgroundColor3 = Color3.fromRGB(0, 80, 150)
            end)
            btn.MouseLeave:Connect(function()
                btn.BackgroundColor3 = Color3.fromRGB(20, 20, 35)
            end)
            
            yPos = yPos + 33
        end
    end
    
    if yPos == 0 then
        local emptyLabel = Instance.new("TextLabel")
        emptyLabel.Size = UDim2.new(1, 0, 1, 0)
        emptyLabel.Text = "Không có người chơi"
        emptyLabel.TextColor3 = Color3.fromRGB(150, 150, 150)
        emptyLabel.BackgroundTransparency = 1
        emptyLabel.Font = Enum.Font.Gotham
        emptyLabel.TextSize = 13
        emptyLabel.Parent = playerList
        yPos = 30
    end
    
    playerList.CanvasSize = UDim2.new(0, 0, 0, yPos)
end

-- Hàm fling (đã cải tiến)
local function flingTarget(target)
    if not target or not target.Character then 
        statusLabel.Text = "❌ Không tìm thấy"
        statusLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
        return false
    end
    
    local targetRoot = target.Character:FindFirstChild("HumanoidRootPart")
    local targetHumanoid = target.Character:FindFirstChild("Humanoid")
    
    if not targetRoot or not targetHumanoid then 
        statusLabel.Text = "❌ Lỗi target"
        statusLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
        return false
    end
    
    isFlinging = true
    
    -- Tàng hình
    humanoid.Health = 0
    character:SetAttribute("Flinging", true)
    
    -- Lưu vị trí cũ để phục hồi
    local oldPos = rootPart.Position
    
    -- Tạo BodyVelocity để bay nhanh
    local bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
    bv.Parent = rootPart
    
    -- Bay nhanh hơn (5 giây)
    local startTime = tick()
    local duration = 5
    
    while tick() - startTime < duration and isFlingEnabled do
        if targetRoot and targetRoot.Position then
            local direction = (targetRoot.Position - rootPart.Position).Unit
            local distance = (targetRoot.Position - rootPart.Position).Magnitude
            
            -- Tăng tốc độ bay (nhanh hơn)
            local speed = math.min(distance * 1.5 + 100, 400)
            
            bv.Velocity = direction * speed + Vector3.new(0, 30, 0)
            
            local timeLeft = math.ceil(duration - (tick() - startTime))
            statusLabel.Text = "🔄 Bay đến " .. target.Name .. " " .. timeLeft .. "s"
        end
        task.wait(0.03)
    end
    
    -- ĐÁ NGƯỜI CHƠI (Fling mạnh)
    if targetRoot and isFlingEnabled then
        statusLabel.Text = "💥 FLING " .. target.Name .. "!!!"
        statusLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
        
        -- Tạo nhiều lực để đá
        -- 1. BodyVelocity chính
        local flingVelocity = Instance.new("BodyVelocity")
        flingVelocity.MaxForce = Vector3.new(1e9, 1e9, 1e9)
        flingVelocity.Velocity = Vector3.new(
            math.random(-8000, 8000),
            math.random(5000, 10000),
            math.random(-8000, 8000)
        )
        flingVelocity.Parent = targetRoot
        
        -- 2. BodyForce đẩy lên
        local bf1 = Instance.new("BodyForce")
        bf1.Force = Vector3.new(0, 1000000, 0)
        bf1.Parent = targetRoot
        
        -- 3. BodyForce đẩy theo hướng
        local bf2 = Instance.new("BodyForce")
        bf2.Force = Vector3.new(
            math.random(-500000, 500000),
            500000,
            math.random(-500000, 500000)
        )
        bf2.Parent = targetRoot
        
        -- 4. BodyPosition để kéo xa
        local bp = Instance.new("BodyPosition")
        bp.MaxForce = Vector3.new(1e9, 1e9, 1e9)
        bp.P = 100000
        bp.Position = Vector3.new(
            math.random(-99999, 99999),
            math.random(50000, 99999),
            math.random(-99999, 99999)
        )
        bp.Parent = targetRoot
        
        -- Xóa sau 3 giây
        game:GetService("Debris"):AddItem(flingVelocity, 3)
        game:GetService("Debris"):AddItem(bf1, 3)
        game:GetService("Debris"):AddItem(bf2, 3)
        game:GetService("Debris"):AddItem(bp, 3)
        
        -- Hiệu ứng
        for i = 1, 8 do
            if targetRoot then
                local part = Instance.new("Part")
                part.Size = Vector3.new(1, 1, 1)
                part.Position = targetRoot.Position + Vector3.new(math.random(-15, 15), math.random(-15, 15), math.random(-15, 15))
                part.BrickColor = BrickColor.new("Bright blue")
                part.Material = Enum.Material.Neon
                part.Anchored = true
                part.CanCollide = false
                part.Parent = game.Workspace
                game:GetService("Debris"):AddItem(part, 0.3)
            end
            task.wait(0.05)
        end
        
        statusLabel.Text = "✅ Đã fling " .. target.Name
        statusLabel.TextColor3 = Color3.fromRGB(0, 255, 150)
    end
    
    -- Phục hồi tàng hình
    humanoid.Health = 100
    character:SetAttribute("Flinging", false)
    
    bv:Destroy()
    isFlinging = false
    
    return true
end

