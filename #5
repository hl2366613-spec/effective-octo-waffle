    MainFrame.Visible = false
    OpenBtn.Visible = true
end)

-- Nhấn nút tròn -> Mở lại Menu
OpenBtn.MouseButton1Click:Connect(function()
    MainFrame.Visible = true
    OpenBtn.Visible = false
end)

-- Toggle ON/OFF
ToggleBtn.MouseButton1Click:Connect(function()
    isToggled = not isToggled
    if isToggled then
        ToggleBtn.Text = "Ngồi Lên Đầu: ON"
        ToggleBtn.TextColor3 = Color3.fromRGB(100, 255, 100)
        StartSitting() -- Bắt đầu ngồi
    else
        ToggleBtn.Text = "Ngồi Lên Đầu: OFF"
        ToggleBtn.TextColor3 = Color3.fromRGB(255, 100, 100)
        StopSitting() -- Dừng ngồi
    end
end)

-- Mở/Tắt Bảng Player
SelectPlayerBtn.MouseButton1Click:Connect(function()
    SubFrame.Visible = not SubFrame.Visible
    if SubFrame.Visible then
        RefreshPlayerList()
    end
end)

-- Xử lý khi player mục tiêu rời game
Players.PlayerRemoving:Connect(function(player)
    if player == selectedPlayer then
        selectedPlayer = nil
        SelectPlayerBtn.Text = "Chọn Player: [Chưa Chọn]"
        -- Nếu đang ngồi thì tắt
        if isToggled then
            isToggled = false
            ToggleBtn.Text = "Ngồi Lên Đầu: OFF"
            ToggleBtn.TextColor3 = Color3.fromRGB(255, 100, 100)
            StopSitting()
        end
    end
end)
