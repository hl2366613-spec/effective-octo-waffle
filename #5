-- ======================== BIẾN LOGIC ========================
local isToggled = false
local selectedPlayer = nil          -- Lưu instance của Player được chọn
local sitConnection = nil           -- Connection của RunService để dừng khi tắt

-- ======================== HÀM XỬ LÝ NGỒI LÊN ĐẦU ========================
local function StopSitting()
    if sitConnection then
        sitConnection:Disconnect()
        sitConnection = nil
    end
end

local function StartSitting()
    StopSitting() -- Đảm bảo không có loop cũ

    -- Kiểm tra đã chọn player chưa
    if not selectedPlayer then
        isToggled = false
        ToggleBtn.Text = "Ngồi Lên Đầu: OFF"
        ToggleBtn.TextColor3 = Color3.fromRGB(255, 100, 100)
        return
    end

    -- Bắt đầu vòng lặp cập nhật vị trí
    sitConnection = RunService.Heartbeat:Connect(function()
        -- Nếu toggle bị tắt giữa chừng thì tự ngắt
        if not isToggled then
            StopSitting()
            return
        end

        local targetCharacter = selectedPlayer.Character
        local localCharacter = LocalPlayer.Character

        -- Nếu một trong hai nhân vật không tồn tại (chết, rời game,...)
        if not targetCharacter or not localCharacter then
            StopSitting()
            isToggled = false
            ToggleBtn.Text = "Ngồi Lên Đầu: OFF"
            ToggleBtn.TextColor3 = Color3.fromRGB(255, 100, 100)
            return
        end

        local targetHead = targetCharacter:FindFirstChild("Head") or targetCharacter:FindFirstChild("HumanoidRootPart")
        local localHRP = localCharacter:FindFirstChild("HumanoidRootPart")

        if not targetHead or not localHRP then
            StopSitting()
            isToggled = false
            ToggleBtn.Text = "Ngồi Lên Đầu: OFF"
            ToggleBtn.TextColor3 = Color3.fromRGB(255, 100, 100)
            return
        end

        -- Tính khoảng cách để đặt localHRP lên trên đầu target
        local offsetY = targetHead.Size.Y / 2 + localHRP.Size.Y / 2 + 0.5 -- cộng thêm 0.5 stud
        local targetPos = targetHead.Position + Vector3.new(0, offsetY, 0)

        -- Đặt vị trí và giữ nguyên hướng yaw (đứng thẳng)
        localHRP.CFrame = CFrame.new(targetPos) * CFrame.Angles(0, math.rad(localHRP.Orientation.Y), 0)

        -- Đặt vận tốc về 0 để tránh bị trôi
        localHRP.Velocity = Vector3.new(0, 0, 0)
        localHRP.RotVelocity = Vector3.new(0, 0, 0)
    end)
end

-- ======================== CẬP NHẬT DANH SÁCH PLAYER ========================
local function RefreshPlayerList()
    -- Xóa các item cũ
    for _, child in pairs(ScrollList:GetChildren()) do
        if child:IsA("Frame") or child:IsA("TextButton") then
            child:Destroy()
        end
    end

    local count = 0
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            count = count + 1

            local ItemFrame = Instance.new("Frame")
            ItemFrame.Size = UDim2.new(1, 0, 0, 35)
            ItemFrame.BackgroundColor3 = Color3.fromRGB(40, 30, 50)
            ItemFrame.Parent = ScrollList

            local ItemCorner = Instance.new("UICorner")
            ItemCorner.CornerRadius = UDim.new(0, 6)
            ItemCorner.Parent = ItemFrame

            local AvatarImg = Instance.new("ImageLabel")
            AvatarImg.Size = UDim2.new(0, 28, 0, 28)
            AvatarImg.Position = UDim2.new(0, 4, 0.5, -14)
            AvatarImg.BackgroundTransparency = 1
            AvatarImg.Image = Players:GetUserThumbnailAsync(player.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size420x420)
            AvatarImg.Parent = ItemFrame

            local AvatarCorner = Instance.new("UICorner")
            AvatarCorner.CornerRadius = UDim.new(1, 0)
            AvatarCorner.Parent = AvatarImg

            local NameBtn = Instance.new("TextButton")
            NameBtn.Size = UDim2.new(1, -38, 1, 0)
            NameBtn.Position = UDim2.new(0, 36, 0, 0)
            NameBtn.BackgroundTransparency = 1
            NameBtn.Text = player.DisplayName
            NameBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            NameBtn.TextSize = 12
            NameBtn.Font = Enum.Font.SourceSans
            NameBtn.TextXAlignment = Enum.TextXAlignment.Left
            NameBtn.Parent = ItemFrame

            -- Khi chọn player, lưu instance và cập nhật nút
            NameBtn.MouseButton1Click:Connect(function()
                selectedPlayer = player
                SelectPlayerBtn.Text = "Player: " .. player.DisplayName
                SubFrame.Visible = false
            end)
        end
    end
    ScrollList.CanvasSize = UDim2.new(0, 0, 0, count * 40)
end

-- ======================== XỬ LÝ SỰ KIỆN NÚT ========================
-- Thu nhỏ Menu -> Hiện nút tròn
