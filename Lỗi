-- Helper: Create Button
function createButton(text)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -10, 0, 35)
    btn.BackgroundColor3 = Color3.new(0.2, 0.2, 0.2)
    btn.TextColor3 = Color3.new(1, 1, 1)
    btn.Text = text
    btn.TextSize = 16
    btn.Font = Enum.Font.Gotham
    btn.BorderSizePixel = 0
    btn.Parent = uiList
    btn.AutoButtonColor = true
    
    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim2.new(0, 5, 0, 5)
    btnCorner.Parent = btn
    
    return btn
end

-- Helper: Create Slider
function createSlider(text, min, max, default, callback)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, -10, 0, 50)
    frame.BackgroundTransparency = 1
    frame.Parent = uiList
    
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0.5, 0, 0, 20)
    label.Position = UDim2.new(0, 0, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = text .. ": " .. tostring(default)
    label.TextColor3 = Color3.new(1, 1, 1)
    label.TextSize = 14
    label.Font = Enum.Font.Gotham
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = frame
    
    local slider = Instance.new("Frame")
    slider.Size = UDim2.new(0.6, 0, 0, 20)
    slider.Position = UDim2.new(0.4, 0, 0.6, 0)
    slider.BackgroundColor3 = Color3.new(0.3, 0.3, 0.3)
    slider.Parent = frame
    
    local sliderCorner = Instance.new("UICorner")
    sliderCorner.CornerRadius = UDim2.new(0, 10, 0, 10)
    sliderCorner.Parent = slider
    
    local fill = Instance.new("Frame")
    fill.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
    fill.BackgroundColor3 = Color3.new(0, 0.5, 1)
    fill.Parent = slider
    
    local fillCorner = Instance.new("UICorner")
    fillCorner.CornerRadius = UDim2.new(0, 10, 0, 10)
    fillCorner.Parent = fill
    
    local drag = Instance.new("TextButton")
    drag.Size = UDim2.new(0, 16, 0, 16)
    drag.Position = UDim2.new((default - min) / (max - min), -8, 0.5, -8)
    drag.BackgroundColor3 = Color3.new(1, 1, 1)
    drag.BorderSizePixel = 0
    drag.Text = ""
    drag.Parent = slider
    
    local dragCorner = Instance.new("UICorner")
    dragCorner.CornerRadius = UDim2.new(1, 0, 1, 0)
    dragCorner.Parent = drag
    
    local value = default
    
    drag.MouseButton1Down:Connect(function()
        local connection
        connection = RunService.RenderStepped:Connect(function()
            local mousePos = mouse.X
            local sliderPos = slider.AbsolutePosition.X
            local sliderSize = slider.AbsoluteSize.X
            if sliderSize == 0 then return end
            
            local percent = math.clamp((mousePos - sliderPos) / sliderSize, 0, 1)
            value = min + (max - min) * percent
            value = math.round(value)
            
            fill.Size = UDim2.new(percent, 0, 1, 0)
            drag.Position = UDim2.new(percent, -8, 0.5, -8)
            label.Text = text .. ": " .. tostring(value)
            
            callback(value)
        end)
        
        local release
        release = UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                connection:Disconnect()
                release:Disconnect()
            end
        end)
    end)
    
    return frame
end

