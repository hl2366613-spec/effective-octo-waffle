-- ===== HÀM TẠO VIỀN GRADIENT =====
local function createGradientBorder(size, position, transparency)
    local outer = Instance.new("Frame")
    outer.Size = size
    outer.Position = position
    outer.BackgroundColor3 = Color3.new(1,1,1)
    outer.BackgroundTransparency = transparency or 0
    outer.BorderSizePixel = 0
    outer.ClipsDescendants = true
    outer.Active = true
    outer.Draggable = true

    local gradient = Instance.new("UIGradient")
    gradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(0, 100, 255)),
        ColorSequenceKeypoint.new(0.3, Color3.fromRGB(0, 200, 255)),
        ColorSequenceKeypoint.new(0.6, Color3.fromRGB(138, 43, 226)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(0, 100, 255))
    })
    gradient.Rotation = 45
    gradient.Parent = outer

    local inner = Instance.new("Frame")
    inner.Size = UDim2.new(1, -6, 1, -6)
    inner.Position = UDim2.new(0, 3, 0, 3)
    inner.BackgroundColor3 = Color3.fromRGB(8, 8, 12)
    inner.BackgroundTransparency = 0
    inner.BorderSizePixel = 0
    inner.Parent = outer

    return outer, inner
end

