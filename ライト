-- ===== CƠ CHẾ DI CHUYỂN MENU =====
local function makeDraggable(frame)
    local dragging = false
    local dragStartPos = nil
    local startMousePos = nil

    frame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStartPos = frame.Position
            startMousePos = input.Position
        end
    end)

    frame.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - startMousePos
            local scaleX = delta.X / screenGui.AbsoluteSize.X
            local scaleY = delta.Y / screenGui.AbsoluteSize.Y
            frame.Position = UDim2.new(dragStartPos.X.Scale + scaleX, dragStartPos.X.Offset + delta.X, 
                                       dragStartPos.Y.Scale + scaleY, dragStartPos.Y.Offset + delta.Y)
        end
    end)

    frame.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end

