-- ===== CHỨC NĂNG FLY =====
local flyConn
local function toggleFly()
    flyEnabled = not flyEnabled
    if flyEnabled then
        local bodyVelocity = Instance.new("BodyVelocity")
        bodyVelocity.MaxForce = Vector3.new(1,1,1) * 1e9
        bodyVelocity.Velocity = Vector3.new(0,0,0)
        bodyVelocity.Parent = hrp or char

        flyConn = RunService.Heartbeat:Connect(function()
            if not flyEnabled or not hrp then return end
            local moveDir = Vector3.new()
            local fwd = hrp.CFrame.LookVector
            local right = hrp.CFrame.RightVector
            local up = Vector3.new(0,1,0)

            if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + fwd * flySpeed end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - fwd * flySpeed end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - right * flySpeed end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + right * flySpeed end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveDir = moveDir + up * flySpeed end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then moveDir = moveDir - up * flySpeed end

            hrp.Velocity = moveDir
        end)
    else
        if flyConn then flyConn:Disconnect() end
        if hrp then hrp.Velocity = Vector3.new(0,0,0) end
    end
end

-- ===== FLYJUMP (Double Jump + Giữ bay lên) =====
local flyJumpConn
local function toggleFlyJump()
    flyJumpEnabled = not flyJumpEnabled
    if flyJumpEnabled then
        local jumpCount = 0
        local humanoid = char and char:FindFirstChild("Humanoid")

        flyJumpConn = RunService.Heartbeat:Connect(function()
            if not char or not humanoid then return end
            if humanoid:GetState() == Enum.HumanoidStateType.Jumping then
                jumpCount = jumpCount + 1
                if jumpCount >= 2 then
                    humanoid.PlatformStand = true
                    local vel = Instance.new("BodyVelocity")
                    vel.MaxForce = Vector3.new(0, 1e9, 0)
                    vel.Velocity = Vector3.new(0, flySpeed, 0)
                    vel.Parent = hrp
                    
                    task.wait(0.1)
                    vel:Destroy()
                    humanoid.PlatformStand = false
                end
            elseif humanoid:GetState() == Enum.HumanoidStateType.Landed then
                jumpCount = 0
            end
        end)
    else
        if flyJumpConn then flyJumpConn:Disconnect() end
        if char and char:FindFirstChild("Humanoid") then
            char.Humanoid.PlatformStand = false
        end
    end
end

-- ===== NOCLIP =====
local noclipConn
local function toggleNoclip()
    noclipEnabled = not noclipEnabled
    if noclipEnabled then
        noclipConn = RunService.Heartbeat:Connect(function()
            if not noclipEnabled or not char then return end
            for _, part in pairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end
        end)
    else
        if noclipConn then noclipConn:Disconnect() end
        if char then
            for _, part in pairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = true
                end
            end
        end
    end
end

-- ===== ESP (Nhìn xuyên thấu) =====
local espConn
local function toggleESP()
    espEnabled = not espEnabled
    if espEnabled then
        espConn = RunService.Heartbeat:Connect(function()
            for _, plr in pairs(Players:GetPlayers()) do
                if plr ~= player and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                    local root = plr.Character.HumanoidRootPart
                    local pos, onScreen = camera:WorldToViewportPoint(root.Position)
                    
                    if onScreen then
                        if not espObjects[plr] then
                            local espBox = Instance.new("Frame")
                            espBox.Size = UDim2.new(0, 40, 0, 80)
                            espBox.Position = UDim2.new(0, pos.X - 20, 0, pos.Y - 40)
                            espBox.BackgroundColor3 = Color3.fromRGB(0, 255, 255)
                            espBox.BackgroundTransparency = 0.3
                            espBox.BorderSizePixel = 0
                            espBox.ZIndex = 5
                            espBox.Parent = screenGui

                            local espName = Instance.new("TextLabel")
                            espName.Size = UDim2.new(1, 0, 0, 20)
                            espName.Position = UDim2.new(0, 0, 1, 0)
                            espName.BackgroundTransparency = 1
                            espName.Text = plr.Name
                            espName.TextColor3 = Color3.fromRGB(255, 255, 255)
                            espName.TextScaled = true
                            espName.Font = Enum.Font.GothamBold
                            espName.ZIndex = 6
                            espName.Parent = espBox

                            espObjects[plr] = espBox
                        else
                            local espBox = espObjects[plr]
                            espBox.Position = UDim2.new(0, pos.X - 20, 0, pos.Y - 40)
                        end
                    else
                        if espObjects[plr] then
                            espObjects[plr]:Destroy()
                            espObjects[plr] = nil
                        end
                    end
                end
            end
        end)
    else
        if espConn then espConn:Disconnect() end
        for _, obj in pairs(espObjects) do
            obj:Destroy()
        end
        espObjects = {}
    end
end

-- ===== TELEPORT =====
local function teleportToPlayer(target)
    if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
        local pos = target.Character.HumanoidRootPart.Position + Vector3.new(0, 3, 0)
        if char and char:FindFirstChild("HumanoidRootPart") then
            char.HumanoidRootPart.CFrame = CFrame.new(pos)
        end
    end
end

-- ===== HEADSIT (Ngồi lên đầu người chơi) =====
local function headSitOnPlayer(target)
    if target and target.Character and target.Character:FindFirstChild("Head") then
        local headPos = target.Character.Head.Position + Vector3.new(0, 1.5, 0)
        if char and char:FindFirstChild("HumanoidRootPart") then
            char.HumanoidRootPart.CFrame = CFrame.new(headPos)
            char.Humanoid.Sit = true
        end
    end
end

-- ===== ĐIỀU CHỈNH TỐC ĐỘ =====
local function setSpeed(amount)
    speed = math.clamp(speed + amount, 0, 250)
    if char and char:FindFirstChild("Humanoid") then
        char.Humanoid.WalkSpeed = speed
    end
end

