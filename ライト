local function hideMenu()
    if not menuVisible then return end
    menuVisible = false
    local tweenInfo = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local tween = TweenService:Create(mainOuter, tweenInfo, {Position = UDim2.new(1.1, 0, mainOuter.Position.Y.Scale, mainOuter.Position.Y.Offset)})
    tween:Play()
    arrowBtn.Visible = true
    local arrowTween = TweenService:Create(arrowBtn, tweenInfo, {Position = UDim2.new(1, -60, 0.5, -22.5)})
    arrowTween:Play()
end

local function showMenu()
    if menuVisible then return end
    menuVisible = true
    local tweenInfo = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local tween = TweenService:Create(mainOuter, tweenInfo, {Position = menuPos})
    tween:Play()
    arrowBtn.Visible = false
    arrowBtn.Position = UDim2.new(1, -55, 0.5, -22.5)
    resetTimer()
end

