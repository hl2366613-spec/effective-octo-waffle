-- [ 4. LOGIC XỬ LÝ ]
local selectedTarget = nil
local currentCallback = nil

local function CreateBtn(name, mode, callback)
    local btn = Instance.new("TextButton", MainFrame)
    btn.Size = UDim2.new(0.8, 0, 0, 35)
    btn.Position = UDim2.new(0.1, 0, 0, 0)
    btn.BackgroundColor3 = Color3.fromRGB(40, 42, 50)
    btn.Text = name
    btn.TextColor3 = Color3.new(1,1,1)
    Instance.new("UICorner", btn)

    btn.MouseButton1Click:Connect(function()
        ActionFrame.Visible = true
        currentCallback = callback
        
        if mode == "Input" then
            InputBox.Visible = true
            PlayerScroll.Visible = false
        elseif mode == "Player" then
            InputBox.Visible = false
            PlayerScroll.Visible = true
            -- Clear cũ
            for _, c in pairs(PlayerScroll:GetChildren()) do if not c:IsA("UIListLayout") then c:Destroy() end end
            -- Load list
            for _, p in pairs(Players:GetPlayers()) do
                local pBtn = Instance.new("TextButton", PlayerScroll)
                pBtn.Size = UDim2.new(1, 0, 0, 30)
                pBtn.Text = p.Name
                pBtn.MouseButton1Click:Connect(function() selectedTarget = p; pBtn.BackgroundColor3 = Color3.new(1,0,0) end)
                pBtn.Parent = PlayerScroll
            end
        end
    end)
end

-- [ NÚT XÁC NHẬN CHUNG ]
ConfirmBtn.MouseButton1Click:Connect(function()
    if InputBox.Visible then
        currentCallback(tonumber(InputBox.Text))
    elseif PlayerScroll.Visible and selectedTarget then
        currentCallback(selectedTarget)
    end
    ActionFrame.Visible = false
end)

