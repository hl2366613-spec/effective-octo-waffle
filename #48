local miniMenus = {}

local function CreateMiniMenu(key, titleText, width, height)
    -- Nếu đã tồn tại → toggle
    if miniMenus[key] then
        miniMenus[key].frame:Destroy()
        miniMenus[key] = nil
        return nil
    end

    local frame = Instance.new("Frame")
    frame.Name = "Mini_" .. key
    frame.Size = UDim2.new(0, width or 200, 0, height or 150)
    -- So le vị trí
    local count = 0
    for _ in pairs(miniMenus) do count = count + 1 end
    frame.Position = UDim2.new(0, 20 + count * 25, 0, 200 + count * 30)
    frame.BackgroundColor3 = THEME.MainBg
    frame.BackgroundTransparency = 0.05
    frame.BorderSizePixel = 0
    frame.Active = true
    frame.Draggable = true
    frame.ZIndex = 50
    frame.Parent = FloatingFolder
    CreateCorner(frame, 12)
    CreateStroke(frame, 1.5, THEME.Border)

    -- Title bar (có thể kéo)
    local titleBar = Instance.new("TextLabel")
    titleBar.Size = UDim2.new(1, -30, 0, 22)
    titleBar.Position = UDim2.new(0, 6, 0, 4)
    titleBar.BackgroundTransparency = 1
    titleBar.Text = titleText
    titleBar.TextColor3 = THEME.Accent
    titleBar.TextSize = 11
    titleBar.Font = Enum.Font.FredokaOne
    titleBar.TextXAlignment = Enum.TextXAlignment.Left
    titleBar.ZIndex = 51
    titleBar.Parent = frame

    local closeBtn = Instance.new("TextButton")
    closeBtn.Size = UDim2.new(0, 20, 0, 20)
    closeBtn.Position = UDim2.new(1, -24, 0, 4)
    closeBtn.BackgroundColor3 = THEME.ButtonBg
    closeBtn.Text = "✖"
    closeBtn.TextColor3 = THEME.Inactive
    closeBtn.TextSize = 11
    closeBtn.Font = Enum.Font.FredokaOne
    closeBtn.AutoButtonColor = false
    closeBtn.ZIndex = 52
    closeBtn.Parent = frame
    CreateCorner(closeBtn, 6)
    CreateStroke(closeBtn, 1, THEME.Border)

    -- Nội dung
    local content = Instance.new("Frame")
    content.Size = UDim2.new(1, -12, 1, -32)
    content.Position = UDim2.new(0, 6, 0, 28)
    content.BackgroundTransparency = 1
    content.ZIndex = 51
    content.Parent = frame

    local layout = Instance.new("UIListLayout")
    layout.Parent = content
    layout.Padding = UDim.new(0, 4)
    layout.SortOrder = Enum.SortOrder.LayoutOrder

    local entry = { frame = frame, content = content, layout = layout }

    closeBtn.MouseButton1Click:Connect(function()
        if miniMenus[key] then
            miniMenus[key].frame:Destroy()
            miniMenus[key] = nil
        end
    end)

    miniMenus[key] = entry
    return entry
end

