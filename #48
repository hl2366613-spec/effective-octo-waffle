    popup.ZIndex = 60
    popup.Parent = btn
    CreateCorner(popup, 8)
    CreateStroke(popup, 1, THEME.Border)

    local scroll = Instance.new("ScrollingFrame")
    scroll.Size = UDim2.new(0.9, 0, 1, -8)
    scroll.Position = UDim2.new(0.05, 0, 0, 4)
    scroll.BackgroundTransparency = 1
    scroll.BorderSizePixel = 0
    scroll.ScrollBarThickness = 2
    scroll.ZIndex = 61
    scroll.Parent = popup

    local scrollLayout = Instance.new("UIListLayout")
    scrollLayout.Parent = scroll
    scrollLayout.Padding = UDim.new(0, 3)

    local function refresh()
        for _, c in ipairs(scroll:GetChildren()) do
            if c:IsA("TextButton") then c:Destroy() end
        end
        local count = 0
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then
                count = count + 1
                local pb = Instance.new("TextButton")
                pb.Size = UDim2.new(1, 0, 0, 22)
                pb.BackgroundColor3 = THEME.ContainerBg
                pb.Text = p.DisplayName
                pb.TextColor3 = THEME.TextDark
                pb.TextSize = 10
                pb.Font = Enum.Font.FredokaOne
                pb.ZIndex = 62
                pb.Parent = scroll
                CreateCorner(pb, 5)
                pb.MouseButton1Click:Connect(function()
                    onSelect(p)
                    btn.Text = btnText:gsub("%[.*%]", "") .. p.DisplayName
                    popup.Visible = false
                end)
            end
        end
        popup.Size = UDim2.new(0, 140, 0, math.min(20 + count * 25, 180))
        scroll.CanvasSize = UDim2.new(0, 0, 0, count * 25 + 8)
    end

    btn.MouseButton1Click:Connect(function()
        popup.Visible = not popup.Visible
        if popup.Visible then refresh() end
    end)

    return btn
end

