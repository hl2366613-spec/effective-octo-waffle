local function MiniToggle(parent, text, getState, setState)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 26)
    btn.BackgroundColor3 = THEME.ButtonBg
    btn.Text = text .. ": " .. (getState() and "ON" or "OFF")
    btn.TextColor3 = getState() and THEME.Active or THEME.Inactive
    btn.TextSize = 11
    btn.Font = Enum.Font.FredokaOne
    btn.AutoButtonColor = false
    btn.Parent = parent
    CreateCorner(btn, 7)
    CreateStroke(btn, 1, THEME.Border)

    btn.MouseButton1Click:Connect(function()
        setState(not getState())
        btn.Text = text .. ": " .. (getState() and "ON" or "OFF")
        btn.TextColor3 = getState() and THEME.Active or THEME.Inactive
    end)

    return btn
end

local function MiniAdjuster(parent, titleText, getValue, setValue, step, minVal, maxVal)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, 0, 0, 26)
    frame.BackgroundColor3 = THEME.ContainerBg
    frame.Parent = parent
    CreateCorner(frame, 7)
    CreateStroke(frame, 1, THEME.Border)

    local minus = Instance.new("TextButton")
    minus.Size = UDim2.new(0, 26, 1, 0)
    minus.BackgroundColor3 = THEME.ButtonBg
    minus.Text = "-"
    minus.TextColor3 = THEME.TextDark
    minus.Font = Enum.Font.FredokaOne
    minus.Parent = frame
    CreateCorner(minus, 6)

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -56, 1, 0)
    label.Position = UDim2.new(0, 28, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = titleText .. ": " .. tostring(getValue())
    label.TextColor3 = THEME.TextDark
    label.TextSize = 10
    label.Font = Enum.Font.FredokaOne
    label.Parent = frame

    local plus = Instance.new("TextButton")
    plus.Size = UDim2.new(0, 26, 1, 0)
    plus.Position = UDim2.new(1, -26, 0, 0)
    plus.BackgroundColor3 = THEME.ButtonBg
    plus.Text = "+"
    plus.TextColor3 = THEME.TextDark
    plus.Font = Enum.Font.FredokaOne
    plus.Parent = frame
    CreateCorner(plus, 6)

    minus.MouseButton1Click:Connect(function()
        local v = getValue() - step
        if v < minVal then v = minVal end
        setValue(v)
        label.Text = titleText .. ": " .. tostring(getValue())
    end)
    plus.MouseButton1Click:Connect(function()
        local v = getValue() + step
        if v > maxVal then v = maxVal end
        setValue(v)
        label.Text = titleText .. ": " .. tostring(getValue())
    end)

    return frame
end

