local hue = 0

RunService.Heartbeat:Connect(function(delta)
    hue = (hue + delta * 0.32) % 1
    currentRainbowColor = Color3.fromHSV(hue,0.88,1)

    MainUIStroke.Color = currentRainbowColor
    OpenBtnStroke.Color = currentRainbowColor
    CloseStroke.Color = currentRainbowColor

    TopLine.BackgroundColor3 = currentRainbowColor
    Title.TextColor3 = currentRainbowColor
    VersionLabel.TextColor3 = currentRainbowColor
    OpenBtn.TextColor3 = currentRainbowColor
    VolumeProgress.BackgroundColor3 = currentRainbowColor

    if isRainbowChat then
        ChatPreview.TextColor3 = currentRainbowColor
    end

    RainbowBtn.BackgroundColor3 = currentRainbowColor

    for _, stroke in ipairs(RainbowStrokes) do
        if stroke and stroke.Parent then
            stroke.Color = currentRainbowColor
        end
    end
end)

