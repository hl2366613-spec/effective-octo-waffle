MusicStatus.TextColor3 = Color3.fromRGB(220,220,220)
MusicStatus.TextSize = 12
MusicStatus.Font = Enum.Font.SourceSansBold
MusicStatus.Parent = MusicContent

local function PlayMusic()
    local id = MusicIDInput.Text:gsub("%D","")

    if id == "" then
        MusicStatus.Text = "Status: ID không hợp lệ"
        return
    end

    localSound.SoundId = "rbxassetid://" .. id
    localSound.Looped = _G.MusicLoopEnabled

    pcall(function()
        localSound:Play()
    end)

    MusicStatus.Text = "Status: Playing"
end

PlayBtn.MouseButton1Click:Connect(function()
    if localSound.IsPaused then
        localSound:Resume()
        MusicStatus.Text = "Status: Playing"
    else
        PlayMusic()
    end
end)

PauseBtn.MouseButton1Click:Connect(function()
    if localSound.IsPlaying then
        localSound:Pause()
        MusicStatus.Text = "Status: Paused"
    end
end)

StopBtn.MouseButton1Click:Connect(function()
    localSound:Stop()
    MusicStatus.Text = "Status: Stopped"
end)

LoopBtn.MouseButton1Click:Connect(function()
    _G.MusicLoopEnabled = not _G.MusicLoopEnabled
    localSound.Looped = _G.MusicLoopEnabled

    if _G.MusicLoopEnabled then
        LoopBtn.Text = "🔄 Loop: ON"
        LoopBtn.TextColor3 = Color3.fromRGB(100,255,100)
    else
        LoopBtn.Text = "🔄 Loop: OFF"
        LoopBtn.TextColor3 = Color3.fromRGB(255,100,100)
    end
end)

