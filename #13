local function SetVolume(percent)
    percent = math.clamp(percent,0,1)

    _G.MusicVolume = math.round(percent * 100)
    localSound.Volume = percent

    VolumeProgress.Size = UDim2.new(percent,0,1,0)
    VolumeLabel.Text = "Âm lượng: " .. _G.MusicVolume .. "%"
end

