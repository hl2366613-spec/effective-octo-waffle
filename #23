        end)
    elseif subMenuMode == "swordkill" then
        local randBtn = Instance.new("TextButton", PlayerList)
        randBtn.Size = UDim2.new(1, 0, 0, 25)
        randBtn.BackgroundColor3 = Color3.fromRGB(35, 15, 25)
        randBtn.Text = "[ Random Player ]"
        randBtn.TextColor3 = Color3.fromRGB(255, 100, 100)
        randBtn.Font = Enum.Font.SourceSansBold
        CreateCorner(randBtn, 6)
        RegisterStroke(CreateStroke(randBtn, 1))
        randBtn.MouseButton1Click:Connect(function()
            selectedSwordPlayer = "RANDOM" SelectSwordKillPlayerBtn.Text = "[ SWORD: RANDOM PLAYER ]" SubFrame.Visible = false
        end)
    end

    local count = (subMenuMode == "aim" or subMenuMode == "kill" or subMenuMode == "swordkill") and 1 or 0
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            count = count + 1
            local btn = Instance.new("TextButton", PlayerList)
            btn.Size = UDim2.new(1, 0, 0, 25)
            btn.BackgroundColor3 = Color3.fromRGB(18, 15, 25)
            btn.Text = player.DisplayName
            btn.TextColor3 = Color3.fromRGB(255, 255, 255)
            btn.Font = Enum.Font.SourceSansBold
            CreateCorner(btn, 6)
            RegisterStroke(CreateStroke(btn, 1))
            btn.MouseButton1Click:Connect(function()
                if subMenuMode == "glue" then selectedGluePlayer = player SelectGluePlayerBtn.Text = "[ KEO 502 ]: " .. player.DisplayName
                elseif subMenuMode == "tp" then selectedTPPlayer = player SelectTPPlayerBtn.Text = "[ TELEPORT ]: " .. player.DisplayName
                elseif subMenuMode == "view" then selectedViewPlayer = player SelectViewPlayerBtn.Text = "[ VIEW ]: " .. player.DisplayName if viewEnabled then ToggleView() ToggleView() end
                elseif subMenuMode == "aim" then selectedAimPlayer = player SelectAimPlayerBtn.Text = "[ AIM ]: " .. player.DisplayName
                elseif subMenuMode == "kill" then selectedKillPlayer = player SelectKillPlayerBtn.Text = "[ KILL ]: " .. player.DisplayName
                elseif subMenuMode == "swordkill" then selectedSwordPlayer = player SelectSwordKillPlayerBtn.Text = "[ SWORD ]: " .. player.DisplayName end
                SubFrame.Visible = false
            end)
        end
    end
    PlayerList.CanvasSize = UDim2.new(0, 0, 0, count * 29)
end

