-- LOGIC XỬ LÝ SLIDER
-- ============================================
local activeValueLabel = nil
local activeValueMode = nil
local isDragging = false

local function UpdateSlider(input)
    pcall(function()
        local pos = math.clamp((input.Position.X - SliderTrack.AbsolutePosition.X) / SliderTrack.AbsoluteSize.X, 0, 1)
        SliderFill.Size = UDim2.new(pos, 0, 1, 0)
        SliderKnob.Position = UDim2.new(pos, -8, 0.5, -8)
        local val = math.floor(pos * 200)
        ValDisplay.Text = tostring(val)
        if activeValueLabel then
            activeValueLabel.Text = "[" .. val .. "]"
            if activeValueMode == "Fly" then
                flySpeed = val
            elseif activeValueMode == "Speed" then
                walkSpeed = val
                if char and char:FindFirstChild("Humanoid") and speedEnabled then
                    char.Humanoid.WalkSpeed = val
                end
            elseif activeValueMode == "Jumpow" then
                jumpPower = val
                if char and char:FindFirstChild("Humanoid") then
                    char.Humanoid.JumpPower = val
                end
            end
        end
    end)
end

SliderTrack.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        isDragging = true
        UpdateSlider(input)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if isDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        UpdateSlider(input)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        isDragging = false
    end
end)

-- ============================================
-- CHỨC NĂNG FLY (Giống Infinite Yield)
-- ============================================
local function toggleFly()
    flyEnabled = not flyEnabled
    if flyEnabled then
        if not hrp then updateChar() end
        if hrp then
            pcall(function()
                flyBodyVelocity = Instance.new("BodyVelocity")
                flyBodyVelocity.MaxForce = Vector3.new(1, 1, 1) * 1e9
                flyBodyVelocity.Velocity = Vector3.new(0, 0, 0)
                flyBodyVelocity.Parent = hrp
                
                flyBodyGyro = Instance.new("BodyGyro")
                flyBodyGyro.MaxTorque = Vector3.new(1, 1, 1) * 1e9
                flyBodyGyro.Parent = hrp
            end)
            
            flyConnection = RunService.Heartbeat:Connect(function()
                if not flyEnabled or not hrp or not flyBodyVelocity then 
                    return 
                end
                pcall(function()
                    local forward = hrp.CFrame.LookVector
                    local right = hrp.CFrame.RightVector
                    local up = Vector3.new(0, 1, 0)
                    
                    local moveDir = Vector3.new(0, 0, 0)
                    
                    if UserInputService:IsKeyDown(Enum.KeyCode.W) then
                        moveDir = moveDir + forward * flySpeed
                    end
                    if UserInputService:IsKeyDown(Enum.KeyCode.S) then
                        moveDir = moveDir - forward * flySpeed
                    end
                    if UserInputService:IsKeyDown(Enum.KeyCode.A) then
                        moveDir = moveDir - right * flySpeed
                    end
                    if UserInputService:IsKeyDown(Enum.KeyCode.D) then
                        moveDir = moveDir + right * flySpeed
                    end
                    if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
                        moveDir = moveDir + up * flySpeed
                    end
                    if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
                        moveDir = moveDir - up * flySpeed
                    end
                    
                    flyBodyVelocity.Velocity = moveDir
                    
                    if hrp and flyBodyGyro then
                        flyBodyGyro.CFrame = hrp.CFrame
                    end
                end)
            end)
        end
    else
        if flyConnection then
            flyConnection:Disconnect()
            flyConnection = nil
        end
        pcall(function()
            if flyBodyVelocity then
                flyBodyVelocity:Destroy()
                flyBodyVelocity = nil
            end
            if flyBodyGyro then
                flyBodyGyro:Destroy()
                flyBodyGyro = nil
            end
            if hrp then
                hrp.Velocity = Vector3.new(0, 0, 0)
            end
        end)
    end
end

