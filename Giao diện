-- Toggle creator
local function Toggle(parent, text, y, default)
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -60, 0, 28)
    label.Position = UDim2.fromOffset(12, y)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = GREY
    label.TextSize = 13
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Font = Enum.Font.Gotham
    label.Parent = parent

    local t = Instance.new("TextButton")
    t.Size = UDim2.fromOffset(40, 22)
    t.Position = UDim2.new(1, -52, 0, y + 2)
    t.BackgroundColor3 = default and PURPLE or Color3.fromRGB(45, 43, 55)
    t.Text = ""
    t.AutoButtonColor = false
    t.Parent = parent

    Corner(t, 12)

    local knob = Instance.new("Frame")
    knob.Size = UDim2.fromOffset(16, 16)
    knob.Position = default
        and UDim2.new(1, -19, .5, -8)
        or UDim2.fromOffset(3, 3)
    knob.BackgroundColor3 = WHITE
    knob.Parent = t

    Corner(knob, 10)

    local state = default

    t.MouseButton1Click:Connect(function()
        state = not state

        Tween(t, TweenInfo.new(.15), {
            BackgroundColor3 = state and PURPLE or Color3.fromRGB(45, 43, 55)
        })

        Tween(knob, TweenInfo.new(.15), {
            Position = state
                and UDim2.new(1, -19, .5, -8)
                or UDim2.fromOffset(3, 3)
        })
    end)

    return t
end

