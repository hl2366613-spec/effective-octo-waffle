-- ==================== HIỆU ỨNG CÁNH HOA ANH ĐÀO BAY ====================
local SakuraFolder = Instance.new("Folder")
SakuraFolder.Name = "SakuraParticles"
SakuraFolder.Parent = ScreenGui

local isSakuraActive = false
local function SpawnSakuraPetals()
    isSakuraActive = true
    task.spawn(function()
        while isSakuraActive do
            pcall(function()
                local petal = Instance.new("ImageLabel")
                petal.Size = UDim2.new(0, math.random(18, 28), 0, math.random(18, 28))
                petal.Position = UDim2.new(math.random(), 0, -0.1, 0)
                petal.BackgroundTransparency = 1
                petal.Image = ASSET_IMAGE_ID
                petal.ImageTransparency = math.random(1, 4) / 10
                petal.Parent = SakuraFolder

                local fallDuration = math.random(3, 5)
                local endX = petal.Position.X.Scale + math.random(-25, 25) / 100
                
                local tween = game:GetService("TweenService"):Create(
                    petal,
                    TweenInfo.new(fallDuration, Enum.EasingStyle.Linear),
                    {Position = UDim2.new(endX, 0, 1.1, 0), Rotation = math.random(0, 360)}
                )
                tween:Play()
                
                tween.Completed:Connect(function()
                    petal:Destroy()
                end)
            end)
            task.wait(0.25)
        end
    end)
end

local function StopSakuraPetals()
    isSakuraActive = false
    SakuraFolder:ClearAllChildren()
end

-- ==================== LOGIC FLY CHUẨN (KHÔI PHỤC HOÀN TOÀN) ====================
_G.FlyEnabled = false
local flyConnection, bodyGyro, bodyVelocity = nil, nil, nil

local function StartFly()
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    local hrp = character.HumanoidRootPart
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end

    bodyGyro = Instance.new("BodyGyro")
    bodyGyro.P = 9e4
    bodyGyro.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
    bodyGyro.CFrame = hrp.CFrame
    bodyGyro.Parent = hrp

    bodyVelocity = Instance.new("BodyVelocity")
    bodyVelocity.Velocity = Vector3.new(0, 0.1, 0)
    bodyVelocity.MaxForce = Vector3.new(9e9, 9e9, 9e9)
    bodyVelocity.Parent = hrp

    humanoid.PlatformStand = true

    flyConnection = RunService.RenderStepped:Connect(function()
        if not _G.FlyEnabled then return end
        local camera = Workspace.CurrentCamera
        local moveDir = Vector3.new(0, 0, 0)
        local currentSpeed = speeds[currentSpeedIndex]

        if UserInputService:IsKeyDown(Enum.KeyCode.W) then
            moveDir = moveDir + camera.CFrame.LookVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then
            moveDir = moveDir - camera.CFrame.LookVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then
            moveDir = moveDir - camera.CFrame.RightVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then
            moveDir = moveDir + camera.CFrame.RightVector
        end

        bodyVelocity.Velocity = moveDir * currentSpeed
        bodyGyro.CFrame = camera.CFrame
    end)
end

local function StopFly()
    if flyConnection then flyConnection:Disconnect() end
    if bodyGyro then bodyGyro:Destroy() end
    if bodyVelocity then bodyVelocity:Destroy() end

    local character = LocalPlayer.Character
    if character then
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            humanoid.PlatformStand = false
        end
    end
end

-- Sự kiện bật/tắt Fly kèm hiệu ứng hoa anh đào
FlyBtn.MouseButton1Click:Connect(function()
    _G.FlyEnabled = not _G.FlyEnabled
    if _G.FlyEnabled then
        FlyBtn.Text = "Fly: ON"
        FlyBtn.BackgroundColor3 = THEME.Active -- Đổi sang màu hồng chủ đề
        StartFly()
        SpawnSakuraPetals()
    else
        FlyBtn.Text = "Fly: OFF"
        FlyBtn.BackgroundColor3 = THEME.ButtonBg
        StopFly()
        StopSakuraPetals()
    end
end)
