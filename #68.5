local function CreateAdjuster(parent, titleText, defaultValue)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, -4, 0, 27)
    frame.BackgroundColor3 = THEME.ContainerBg
    frame.Parent = parent
    CreateCorner(frame, 8)
    CreateStroke(frame, 1, THEME.Border)

    local minusBtn = Instance.new("TextButton")
    minusBtn.Size = UDim2.new(0, 25, 1, 0)
    minusBtn.BackgroundColor3 = THEME.ButtonBg
    minusBtn.Text = "-"
    minusBtn.TextColor3 = THEME.TextDark
    minusBtn.Font = Enum.Font.FredokaOne
    minusBtn.Parent = frame
    CreateCorner(minusBtn, 6)

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -54, 1, 0)
    label.Position = UDim2.new(0, 27, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = titleText .. ": " .. tostring(defaultValue)
    label.TextColor3 = THEME.TextDark
    label.TextSize = 10
    label.Font = Enum.Font.FredokaOne
    label.Parent = frame

    local plusBtn = Instance.new("TextButton")
    plusBtn.Size = UDim2.new(0, 25, 1, 0)
    plusBtn.Position = UDim2.new(1, -25, 0, 0)
    plusBtn.BackgroundColor3 = THEME.ButtonBg
    plusBtn.Text = "+"
    plusBtn.TextColor3 = THEME.TextDark
    plusBtn.Font = Enum.Font.FredokaOne
    plusBtn.Parent = frame
    CreateCorner(plusBtn, 6)

    return frame, minusBtn, plusBtn, label
end

