-- ============================================
local NotifyFrame = Instance.new("Frame", ScreenGui)
NotifyFrame.Name = "NotifyFrame"
NotifyFrame.BackgroundColor3 = Color3.fromRGB(15, 17, 23)
NotifyFrame.Position = UDim2.new(0.5, -180, 0.02, 0)
NotifyFrame.Size = UDim2.new(0, 360, 0, 40)
NotifyFrame.ZIndex = 200

local NFCorner = Instance.new("UICorner", NotifyFrame)
NFCorner.CornerRadius = UDim.new(0, 10)
local NFStroke = Instance.new("UIStroke", NotifyFrame)
NFStroke.Thickness = 2

local NotifyText = Instance.new("TextLabel", NotifyFrame)
NotifyText.Size = UDim2.new(1, -20, 1, 0)
NotifyText.Position = UDim2.new(0, 10, 0, 0)
NotifyText.BackgroundTransparency = 1
NotifyText.Font = Enum.Font.GothamBold
NotifyText.Text = "✨ GIAO DIỆN MENU THUỘC BẢN QUYỀN CỦA ライト [ RAITO ] ✨"
NotifyText.TextColor3 = Color3.fromRGB(255, 215, 0)
NotifyText.TextSize = 11
NotifyText.TextWrapped = true
NotifyText.ZIndex = 201

local hue = 0
local rainbowConn
rainbowConn = RunService.RenderStepped:Connect(function(delta)
    if not NotifyFrame or not NotifyFrame.Parent then
        rainbowConn:Disconnect()
        return
    end
    hue = (hue + delta * 0.4) % 1
    local color = Color3.fromHSV(hue, 0.8, 1)
    NotifyText.TextColor3 = color
    NFStroke.Color = color
end)

task.delay(6, function()
    if NotifyFrame and NotifyFrame.Parent then
        TweenService:Create(NotifyFrame, TweenInfo.new(1), {BackgroundTransparency = 1}):Play()
        TweenService:Create(NotifyText, TweenInfo.new(1), {TextTransparency = 1}):Play()
        local t = TweenService:Create(NFStroke, TweenInfo.new(1), {Transparency = 1})
        t:Play()
        t.Completed:Connect(function() NotifyFrame:Destroy() end)
    end
end)

