-- ============================================
-- LOGIC XỬ LÝ SLIDER
-- ============================================
local activeValueLabel = nil
local activeValueMode = nil
local isDragging = false

local function UpdateSlider(input)
    local pos = math.clamp((input.Position.X - SliderTrack.AbsolutePosition.X) / SliderTrack.AbsoluteSize.X, 0, 1)
    SliderFill.Size = UDim2.new(pos, 0, 1, 0)
    SliderKnob.Position = UDim2.new(pos, -8, 0.5, -8)
    local val = math.floor(pos * 200)
    ValDisplay.Text = tostring(val)
    if activeValueLabel then
        activeValueLabel.Text = "[" .. val .. "]"
        if activeValueMode == "Fly" then
            flySpeed = val
        elseif activeValueMode == "Speed" then
            walkSpeed = val
            if char and char:FindFirstChild("Humanoid") and speedEnabled then
                char.Humanoid.WalkSpeed = val
            end
        elseif activeValueMode == "Jumpow" then
            jumpPower = val
            if char and char:FindFirstChild("Humanoid") then
                char.Humanoid.JumpPower = val
            end
        end
    end
end

SliderTrack.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        isDragging = true
        UpdateSlider(input)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if isDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        UpdateSlider(input)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        isDragging = false
    end
end)

-- ============================================
-- CHỨC NĂNG FLY
-- ============================================
local function toggleFly()
    flyEnabled = not flyEnabled
    if flyEnabled then
        if not hrp then updateChar() end
        if hrp then
            local bodyVelocity = Instance.new("BodyVelocity")
            bodyVelocity.MaxForce = Vector3.new(1, 1, 1) * 1e9
            bodyVelocity.Velocity = Vector3.new(0, 0, 0)
            bodyVelocity.Parent = hrp
            
            flyConnection = RunService.Heartbeat:Connect(function()
                if not flyEnabled or not hrp then return end
                local moveDir = Vector3.new()
                if UserInputService:IsKeyDown(Enum.KeyCode.W) then 
                    moveDir = moveDir + hrp.CFrame.LookVector * flySpeed 
                end
                if UserInputService:IsKeyDown(Enum.KeyCode.S) then 
                    moveDir = moveDir - hrp.CFrame.LookVector * flySpeed 
                end
                if UserInputService:IsKeyDown(Enum.KeyCode.A) then 
                    moveDir = moveDir - hrp.CFrame.RightVector * flySpeed 
                end
                if UserInputService:IsKeyDown(Enum.KeyCode.D) then 
                    moveDir = moveDir + hrp.CFrame.RightVector * flySpeed 
                end
                if UserInputService:IsKeyDown(Enum.KeyCode.Space) then 
                    moveDir = moveDir + Vector3.new(0, flySpeed, 0) 
                end
                if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then 
                    moveDir = moveDir - Vector3.new(0, flySpeed, 0) 
                end
                hrp.Velocity = moveDir
            end)
        end
    else
        if flyConnection then 
            flyConnection:Disconnect() 
            flyConnection = nil 
        end
        if hrp then 
            hrp.Velocity = Vector3.new(0, 0, 0) 
        end
    end
end

-- ============================================
-- CHỨC NĂNG SPEED
-- ============================================
local function toggleSpeed()
    speedEnabled = not speedEnabled
    if char and char:FindFirstChild("Humanoid") then
        if speedEnabled then
            char.Humanoid.WalkSpeed = walkSpeed
        else
            char.Humanoid.WalkSpeed = 16
        end
    end
end

-- ============================================
-- CHỨC NĂNG NOCLIP
-- ============================================
local function toggleNoclip()
    noclipEnabled = not noclipEnabled
    if noclipEnabled then
        noclipConnection = RunService.Heartbeat:Connect(function()
            if not noclipEnabled or not char then return end
            for _, part in pairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end
        end)
    else
        if noclipConnection then 
            noclipConnection:Disconnect() 
            noclipConnection = nil 
        end
        if char then
            for _, part in pairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = true
                end
            end
        end
    end
end

-- ============================================
-- CHỨC NĂNG ESP
-- ============================================
local function toggleESP()
    espEnabled = not espEnabled
    if espEnabled then
        espConnection = RunService.Heartbeat:Connect(function()
            for _, plr in pairs(Players:GetPlayers()) do
                if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                    local root = plr.Character.HumanoidRootPart
                    local pos, onScreen = Camera:WorldToViewportPoint(root.Position)
                    
                    if onScreen then
                        if not espObjects[plr] then
                            local espBox = Instance.new("Frame", ScreenGui)
                            espBox.Size = UDim2.new(0, 40, 0, 80)
                            espBox.Position = UDim2.new(0, pos.X - 20, 0, pos.Y - 40)
                            espBox.BackgroundColor3 = Color3.fromRGB(0, 255, 255)
                            espBox.BackgroundTransparency = 0.3
                            espBox.BorderSizePixel = 0
                            espBox.ZIndex = 5

                            local espName = Instance.new("TextLabel", espBox)
                            espName.Size = UDim2.new(1, 0, 0, 20)
                            espName.Position = UDim2.new(0, 0, 1, 0)
                            espName.BackgroundTransparency = 1
                            espName.Text = plr.Name
                            espName.TextColor3 = Color3.fromRGB(255, 255, 255)
                            espName.TextScaled = true
                            espName.Font = Enum.Font.GothamBold
                            espName.ZIndex = 6

                            espObjects[plr] = espBox
                        else
                            local espBox = espObjects[plr]
                            espBox.Position = UDim2.new(0, pos.X - 20, 0, pos.Y - 40)
                        end
                    else
                        if espObjects[plr] then
                            espObjects[plr]:Destroy()
                            espObjects[plr] = nil
                        end
                    end
                end
            end
        end)
    else
        if espConnection then 
            espConnection:Disconnect() 
            espConnection = nil 
        end
        for _, obj in pairs(espObjects) do
            obj:Destroy()
        end
        espObjects = {}
    end
end

-- ============================================
-- CHỨC NĂNG AIMBOT
-- ============================================
local function toggleAimbot()
    aimbotEnabled = not aimbotEnabled
    if aimbotEnabled then
        aimbotConnection = RunService.Heartbeat:Connect(function()
            if not aimbotEnabled or not char or not hrp then return end
            if selectedPlayer and selectedPlayer.Character and selectedPlayer.Character:FindFirstChild("HumanoidRootPart") then
                local targetPos = selectedPlayer.Character.HumanoidRootPart.Position
                local lookAt = CFrame.new(hrp.Position, targetPos)
                hrp.CFrame = CFrame.new(hrp.Position, lookAt.LookVector * 100 + hrp.Position)
            end
        end)
    else
        if aimbotConnection then 
            aimbotConnection:Disconnect() 
            aimbotConnection = nil 
        end
    end
end

-- ============================================
-- CHỨC NĂNG TELEPORT
-- ============================================
local function teleportToPlayer(target)
    if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
        local pos = target.Character.HumanoidRootPart.Position + Vector3.new(0, 3, 0)
        if char and char:FindFirstChild("HumanoidRootPart") then
            char.HumanoidRootPart.CFrame = CFrame.new(pos)
        end
    end
end

-- ============================================
-- CHỨC NĂNG HEADSIT (NGỒI LÊN ĐẦU)
-- ============================================
local function headsitOnPlayer(target)
    if target and target.Character and target.Character:FindFirstChild("Head") then
        local headPos = target.Character.Head.Position + Vector3.new(0, 1.5, 0)
        if char and char:FindFirstChild("HumanoidRootPart") then
            char.HumanoidRootPart.CFrame = CFrame.new(headPos)
            if char:FindFirstChild("Humanoid") then
                char.Humanoid.Sit = true
            end
        end
    end
end

-- ============================================
-- TẠO NÚT CHỨC NĂNG
-- ============================================
local function CreateFeatureRow(name, mode, placeholder)
    local Frame = Instance.new("Frame", Scroll)
    Frame.BackgroundColor3 = Color3.fromRGB(25, 28, 39)
    Frame.Size = UDim2.new(1, -6, 0, 38)
    Frame.ZIndex = 12
    Instance.new("UICorner", Frame).CornerRadius = UDim.new(0, 8)

    local Label = Instance.new("TextLabel", Frame)
    Label.BackgroundTransparency = 1
    Label.Position = UDim2.new(0, 10, 0, 0)
    Label.Size = UDim2.new(0.35, 0, 1, 0)
    Label.Font = Enum.Font.GothamBold
    Label.Text = name
    Label.TextColor3 = Color3.fromRGB(230, 235, 245)
    Label.TextSize = 12
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.ZIndex = 13

    local ValBtn = nil
    if mode == "Value" or mode == "Player" then
        ValBtn = Instance.new("TextButton", Frame)
        ValBtn.BackgroundColor3 = Color3.fromRGB(14, 16, 23)
        ValBtn.Position = UDim2.new(0.38, 0, 0.18, 0)
        ValBtn.Size = UDim2.new(0.42, 0, 0.64, 0)
        ValBtn.Font = Enum.Font.GothamBold
        ValBtn.Text = placeholder
        ValBtn.TextColor3 = Color3.fromRGB(255, 210, 90)
        ValBtn.TextSize = 10
        ValBtn.ZIndex = 13
        Instance.new("UICorner", ValBtn).CornerRadius = UDim.new(0, 5)
    end

    local ToggleBtn = Instance.new("TextButton", Frame)
    ToggleBtn.Position = UDim2.new(1, -30, 0.5, -10)
    ToggleBtn.Size = UDim2.new(0, 20, 0, 20)
    ToggleBtn.BackgroundColor3 = Color3.fromRGB(45, 50, 65)
    ToggleBtn.Font = Enum.Font.GothamBold
    ToggleBtn.Text = ""
    ToggleBtn.ZIndex = 13
    Instance.new("UICorner", ToggleBtn).CornerRadius = UDim.new(1, 0)

    local isToggled = false

    -- Xử lý Value
    if ValBtn and mode == "Value" then
        ValBtn.MouseButton1Click:Connect(function()
            VMTitle.Text = "☀️ Chỉnh " .. name
            activeValueLabel = ValBtn
            activeValueMode = name
            local currentVal = 50
            if name == "Fly" then currentVal = flySpeed
            elseif name == "Speed" then currentVal = walkSpeed
            elseif name == "Jumpow" then currentVal = jumpPower end
            local pos = math.clamp(currentVal / 200, 0, 1)
            SliderFill.Size = UDim2.new(pos, 0, 1, 0)
            SliderKnob.Position = UDim2.new(pos, -8, 0.5, -8)
            ValDisplay.Text = tostring(currentVal)
            ValueModal.Visible = true
            PlayerModal.Visible = false
        end)
    end

    -- Xử lý Player
    if ValBtn and mode == "Player" then
        ValBtn.MouseButton1Click:Connect(function()
            PMTitle.Text = "☀️ Chọn Player: " .. name
            activeValueLabel = ValBtn

            for _, child in pairs(PMScroll:GetChildren()) do
                if child:IsA("Frame") then child:Destroy() end
            end

            for _, plr in pairs(Players:GetPlayers()) do
                if plr ~= LocalPlayer then
                    local PFrame = Instance.new("Frame", PMScroll)
                    PFrame.BackgroundColor3 = Color3.fromRGB(30, 34, 48)
                    PFrame.Size = UDim2.new(1, 0, 0, 32)
                    PFrame.ZIndex = 102
                    Instance.new("UICorner", PFrame).CornerRadius = UDim.new(0, 6)

                    local Avatar = Instance.new("ImageLabel", PFrame)
                    Avatar.Position = UDim2.new(0, 5, 0.1, 0)
                    Avatar.Size = UDim2.new(0, 25, 0, 25)
                    Avatar.BackgroundTransparency = 1
                    Avatar.Image = "rbxthumb://type=AvatarHeadShot&id=" .. plr.UserId .. "&w=150&h=150"
                    Avatar.ZIndex = 103

                    local PBtn = Instance.new("TextButton", PFrame)
                    PBtn.Position = UDim2.new(0, 36, 0, 0)
                    PBtn.Size = UDim2.new(1, -36, 1, 0)
                    PBtn.BackgroundTransparency = 1
                    PBtn.Font = Enum.Font.GothamBold
                    PBtn.Text = plr.DisplayName
                    PBtn.TextColor3 = Color3.fromRGB(255, 220, 120)
                    PBtn.TextSize = 10
                    PBtn.TextXAlignment = Enum.TextXAlignment.Left
                    PBtn.ZIndex = 103

                    PBtn.MouseButton1Click:Connect(function()
                        activeValueLabel.Text = plr.DisplayName
                        selectedPlayer = plr
                        if name == "Teleport" then
                            teleportToPlayer(plr)
                        elseif name == "Headsit" then
                            headsitOnPlayer(plr)
                        elseif name == "Aimbot" then
                            if aimbotEnabled then
                                toggleAimbot()
                                toggleAimbot()
                            else
                                toggleAimbot()
                            end
                        end
                        PlayerModal.Visible = false
                    end)
                end
            end

            PlayerModal.Visible = true
            ValueModal.Visible = false
        end)
    end

    -- Bật/tắt toggle
    ToggleBtn.MouseButton1Click:Connect(function()
        isToggled = not isToggled
        ToggleBtn.BackgroundColor3 = isToggled and Color3.fromRGB(255, 190, 40) or Color3.fromRGB(45, 50, 65)
        
        if name == "Fly" then toggleFly()
        elseif name == "Speed" then toggleSpeed()
        elseif name == "Jumpow" then
            if char and char:FindFirstChild("Humanoid") then
                char.Humanoid.JumpPower = jumpPower
            end
        elseif name == "Noclip" then toggleNoclip()
        elseif name == "ESP" then toggleESP()
        elseif name == "Aimbot" then toggleAimbot()
        end
    end)
end

-- ============================================
-- KHỞI TẠO DANH SÁCH TÍNH NĂNG
-- ============================================
CreateFeatureRow("Fly", "Value", "[ Tốc độ ]")
CreateFeatureRow("Speed", "Value", "[ Tốc độ ]")
CreateFeatureRow("Jumpow", "Value", "[ Độ cao ]")
CreateFeatureRow("Noclip", "None", "")
CreateFeatureRow("ESP", "None", "")
CreateFeatureRow("Aimbot", "Player", "[ Player ]")
CreateFeatureRow("Teleport", "Player", "[ Player ]")
CreateFeatureRow("Headsit", "Player", "[ Player ]")

-- ============================================
-- BẬT/TẮT MENU CHÍNH
-- ============================================
OpenBtn.MouseButton1Click:Connect(function()
    MainFrame.Visible = not MainFrame.Visible
    ValueModal.Visible = false
    PlayerModal.Visible = false
end)

-- ============================================
-- XỬ LÝ KHI NHÂN VẬT RESPAWN
-- ============================================
LocalPlayer.CharacterAdded:Connect(function(newChar)
    char = newChar
    hrp = char:FindFirstChild("HumanoidRootPart")
    wait(0.5)
    
    if char and char:FindFirstChild("Humanoid") then
        if speedEnabled then
            char.Humanoid.WalkSpeed = walkSpeed
        end
        char.Humanoid.JumpPower = jumpPower
    end
    
    if flyEnabled then
        toggleFly()
        toggleFly()
    end
    
    if noclipEnabled then
        toggleNoclip()
        toggleNoclip()
    end
end)

print("✨ ライト [RAITO] Ultra GUI V2.5.0 đã tải thành công!")
print("📌 Bấm ☀️ ở góc trái để mở menu")
