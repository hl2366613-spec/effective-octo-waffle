local activeToggleBtn = nil
local activeValueLabel = nil

local function CreateFeatureRow(name, mode)
    local Frame = Instance.new("Frame", Scroll)
    Frame.BackgroundColor3 = Color3.fromRGB(28, 32, 42)
    Frame.Size = UDim2.new(1, -6, 0, 36)
    local FCorner = Instance.new("UICorner", Frame)
    FCorner.CornerRadius = UDim.new(0, 6)

    local Label = Instance.new("TextLabel", Frame)
    Label.BackgroundTransparency = 1
    Label.Position = UDim2.new(0, 8, 0, 0)
    Label.Size = UDim2.new(0.35, 0, 1, 0)
    Label.Font = Enum.Font.Gotham
    Label.Text = name
    Label.TextColor3 = Color3.fromRGB(240, 240, 240)
    Label.TextSize = 12
    Label.TextXAlignment = Enum.TextXAlignment.Left

    local ValBtn = nil
    if mode == "Value" or mode == "Player" then
        ValBtn = Instance.new("TextButton", Frame)
        ValBtn.BackgroundColor3 = Color3.fromRGB(16, 18, 24)
        ValBtn.Position = UDim2.new(0.38, 0, 0.18, 0)
        ValBtn.Size = UDim2.new(0.42, 0, 0.64, 0)
        ValBtn.Font = Enum.Font.Gotham
        ValBtn.Text = mode == "Value" and "[ Tốc độ ]" or "[ Player ]"
        ValBtn.TextColor3 = Color3.fromRGB(255, 215, 100)
        ValBtn.TextSize = 10
        local VBCorner = Instance.new("UICorner", ValBtn)
        VBCorner.CornerRadius = UDim.new(0, 4)
    end

    local ToggleBtn = Instance.new("TextButton", Frame)
    ToggleBtn.Position = UDim2.new(1, -28, 0.5, -9)
    ToggleBtn.Size = UDim2.new(0, 18, 0, 18)
    ToggleBtn.BackgroundColor3 = Color3.fromRGB(50, 55, 65)
    ToggleBtn.Font = Enum.Font.GothamBold
    ToggleBtn.Text = ""
    local TCorner = Instance.new("UICorner", ToggleBtn)
    TCorner.CornerRadius = UDim.new(1, 0)

    local isToggled = false

    if ValBtn and mode == "Value" then
        ValBtn.MouseButton1Click:Connect(function()
            VMTitle.Text = "Chỉnh " .. name
            activeToggleBtn = ToggleBtn
            activeValueLabel = ValBtn
            ValueModal.Visible = true
            PlayerModal.Visible = false
        end)
    end

    if ValBtn and mode == "Player" then
        ValBtn.MouseButton1Click:Connect(function()
            PMTitle.Text = "Chọn Player cho " .. name
            activeToggleBtn = ToggleBtn
            activeValueLabel = ValBtn

            for _, child in pairs(PMScroll:GetChildren()) do
                if child:IsA("Frame") then child:Destroy() end
            end

            for _, plr in pairs(Players:GetPlayers()) do
                local PFrame = Instance.new("Frame", PMScroll)
                PFrame.BackgroundColor3 = Color3.fromRGB(35, 40, 52)
                PFrame.Size = UDim2.new(1, 0, 0, 28)
                local PFCorner = Instance.new("UICorner", PFrame)
                PFCorner.CornerRadius = UDim.new(0, 4)

                local Avatar = Instance.new("ImageLabel", PFrame)
                Avatar.Position = UDim2.new(0, 4, 0.1, 0)
                Avatar.Size = UDim2.new(0, 22, 0, 22)
                Avatar.BackgroundTransparency = 1
                Avatar.Image = "rbxthumb://type=AvatarHeadShot&id=" .. plr.UserId .. "&w=150&h=150"

                local PBtn = Instance.new("TextButton", PFrame)
                PBtn.Position = UDim2.new(0, 32, 0, 0)
                PBtn.Size = UDim2.new(1, -32, 1, 0)
                PBtn.BackgroundTransparency = 1
                PBtn.Font = Enum.Font.Gotham
                PBtn.Text = plr.DisplayName
                PBtn.TextColor3 = Color3.fromRGB(255, 235, 170)
                PBtn.TextSize = 10
                PBtn.TextXAlignment = Enum.TextXAlignment.Left

                PBtn.MouseButton1Click:Connect(function()
                    activeValueLabel.Text = plr.DisplayName
                end)
            end

            PlayerModal.Visible = true
            ValueModal.Visible = false
        end)
    end

    ToggleBtn.MouseButton1Click:Connect(function()
        isToggled = not isToggled
        ToggleBtn.BackgroundColor3 = isToggled and Color3.fromRGB(255, 200, 50) or Color3.fromRGB(50, 55, 65)
    end)
end

-- Nút [Xác nhận] các Menu phụ
VMConfirm.MouseButton1Click:Connect(function()
    if activeToggleBtn then activeToggleBtn.BackgroundColor3 = Color3.fromRGB(255, 200, 50) end
    if activeValueLabel then activeValueLabel.Text = VMInput.Text end
    ValueModal.Visible = false
end)

PMConfirm.MouseButton1Click:Connect(function()
    if activeToggleBtn then activeToggleBtn.BackgroundColor3 = Color3.fromRGB(255, 200, 50) end
    PlayerModal.Visible = false
end)

