-- Hiệu ứng đổi màu Rainbow liên tục
local hue = 0
RunService.RenderStepped:Connect(function(delta)
    hue = (hue + delta * 0.5) % 1
    local color = Color3.fromHSV(hue, 0.8, 1)
    NotifyText.TextColor3 = color
    NFStroke.Color = color
end)

-- Tự động ẩn thông báo sau 6 giây
task.delay(6, function()
    local tween = TweenService:Create(NotifyFrame, TweenInfo.new(1), {BackgroundTransparency = 1})
    TweenService:Create(NotifyText, TweenInfo.new(1), {TextTransparency = 1}):Play()
    TweenService:Create(NFStroke, TweenInfo.new(1), {Transparency = 1}):Play()
    tween:Play()
    tween.Completed:Connect(function()
        NotifyFrame:Destroy()
    end)
end)

