local function ClearNPCESP()
    for _, data in pairs(espNpcObjects) do
        if data.Text then data.Text:Destroy() end
    end
    espNpcObjects = {}
    EspNpcFolder:ClearAllChildren()
end

EspV2ToggleBtn.MouseButton1Click:Connect(function()
    espNpcEnabled = not espNpcEnabled
    EspV2ToggleBtn.Text = espNpcEnabled and "🐾 ESP V2 (NPC): ON" or "🐾 ESP V2 (NPC): OFF"
    EspV2ToggleBtn.TextColor3 = espNpcEnabled and THEME.Active or THEME.Inactive
    if not espNpcEnabled then ClearNPCESP() end
end)

RunService.RenderStepped:Connect(function()
    if not espNpcEnabled then return end
    local camera = Workspace.CurrentCamera
    local myChar = LocalPlayer.Character
    if not camera or not myChar then return end
    local myRoot = myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end

    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and obj ~= myChar and not Players:GetPlayerFromCharacter(obj) then
            local hum = obj:FindFirstChildOfClass("Humanoid")
            local root = obj:FindFirstChild("HumanoidRootPart")
            if hum and root and hum.Health > 0 then
                if not espNpcObjects[obj] then
                    local label = Instance.new("TextLabel")
                    label.Size = UDim2.new(0, 200, 0, 30)
                    label.BackgroundTransparency = 1
                    label.TextSize = 12
                    label.Font = Enum.Font.FredokaOne
                    label.Parent = EspNpcFolder
                    espNpcObjects[obj] = { Text = label }
                end
                local label = espNpcObjects[obj].Text
                local pos, visible = camera:WorldToViewportPoint(root.Position)
                if visible then
                    local distance = math.floor((myRoot.Position - root.Position).Magnitude)
                    local hp = math.floor((hum.Health / math.max(hum.MaxHealth, 1)) * 100)
                    label.Visible = true
                    label.Position = UDim2.new(0, pos.X - 100, 0, pos.Y - 35)
                    label.Text = string.format("[NPC] %s\nMáu: %d%% | %dm", obj.Name, hp, distance)
                    label.TextColor3 = Color3.fromRGB(255, 180, 100)
                else
                    label.Visible = false
                end
            end
        end
    end
end)

