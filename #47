        angular.Parent = hrp
    else
        local angular = hrp:FindFirstChild("SpinVelocity")
        local attachment = hrp:FindFirstChild("SpinAttachment")
        if angular then angular:Destroy() end
        if attachment then attachment:Destroy() end
    end
end)

