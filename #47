        loopFloat.Parent = content
        CreateCorner(loopFloat, 6)
        CreateStroke(loopFloat, 1, THEME.Border)

        -- Cập nhật label liên tục
        task.spawn(function()
            while floatingButtons["music"] and floatingButtons["music"].frame.Parent do
                if isPlayingMusic and localSound.IsPlaying then
                    timeLbl.Text = "Thời lượng: " .. FormatTime(localSound.TimePosition) .. " / " .. FormatTime(localSound.TimeLength)
