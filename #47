-- Aim
AimToggleBtn.MouseButton1Click:Connect(function()
    aimEnabled = not aimEnabled
    AimToggleBtn.Text = aimEnabled and "🎀 Aim Lock: ON" or "🎀 Aim Lock: OFF"
    AimToggleBtn.TextColor3 = aimEnabled and THEME.Active or THEME.Inactive
    FovFrame.Visible = aimEnabled
end)

RunService.RenderStepped:Connect(function()
    if not aimEnabled then return end
    local camera = Workspace.CurrentCamera
    if not camera then return end

    local target = nil
    if selectedAimPlayer and selectedAimPlayer.Character then
        target = selectedAimPlayer
    else
        -- Tìm player gần tâm màn hình nhất
        local mousePos = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
        local shortest = aimRadiusVar
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                local head = p.Character:FindFirstChild("Head")
                if head then
                    local screenPos, onScreen = camera:WorldToViewportPoint(head.Position)
                    if onScreen then
                        local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                        if dist < shortest then
                            shortest = dist
                            target = p
                        end
                    end
                end
            end
        end
    end

    if target and target.Character then
        local part = target.Character:FindFirstChild("Head") or target.Character:FindFirstChild("HumanoidRootPart")
        if part then
            camera.CFrame = CFrame.new(camera.CFrame.Position, part.Position)
        end
    end
end)

-- Kill
local function StopKill()
    if killConnection then killConnection:Disconnect() killConnection = nil end
end

KillToggleBtn.MouseButton1Click:Connect(function()
    killEnabled = not killEnabled
    KillToggleBtn.Text = killEnabled and "🐾 Kill: ON" or "🐾 Kill: OFF"
    KillToggleBtn.TextColor3 = killEnabled and THEME.Active or THEME.Inactive

    StopKill()
    if killEnabled then
        killConnection = RunService.Heartbeat:Connect(function()
            if not killEnabled then return end
            local char = LocalPlayer.Character
            if not char then return end
            local tool = char:FindFirstChildOfClass("Tool")
            if not tool then return end
            local handle = tool:FindFirstChild("Handle") or tool:FindFirstChildOfClass("BasePart")
            tool:Activate()

            local targets = {}
            if selectedKillPlayer == "ALL" then
                for _, p in pairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer then table.insert(targets, p) end
                end
            elseif typeof(selectedKillPlayer) == "Instance" and selectedKillPlayer:IsA("Player") then
                table.insert(targets, selectedKillPlayer)
            end

            for _, target in pairs(targets) do
                if target and target.Character then
                    local tHrp = target.Character:FindFirstChild("HumanoidRootPart") or target.Character:FindFirstChild("Head")
                    local tHum = target.Character:FindFirstChildOfClass("Humanoid")
                    if tHrp and tHum and tHum.Health > 0 and handle and handle:FindFirstChildOfClass("TouchTransmitter") then
                        firetouchinterest(handle, tHrp, 0)
                        firetouchinterest(handle, tHrp, 1)
                    end
                end
            end
        end)
    end
end)

-- Sword Kill
local function StopSwordKill()
    if swordKillConnection then swordKillConnection:Disconnect() swordKillConnection = nil end
end

SwordKillToggleBtn.MouseButton1Click:Connect(function()
    swordKillEnabled = not swordKillEnabled
    SwordKillToggleBtn.Text = swordKillEnabled and "🐾 Kill With A Sword: ON" or "🐾 Kill With A Sword: OFF"
    SwordKillToggleBtn.TextColor3 = swordKillEnabled and THEME.Active or THEME.Inactive

    StopSwordKill()
    if swordKillEnabled then
        local currentTarget = nil
        swordKillConnection = RunService.Heartbeat:Connect(function()
            if not swordKillEnabled then return end
            local char = LocalPlayer.Character
            if not char then return end
            local myRoot = char:FindFirstChild("HumanoidRootPart")
            local tool = char:FindFirstChildOfClass("Tool")
            if not myRoot or not tool then return end
            local handle = tool:FindFirstChild("Handle") or tool:FindFirstChildOfClass("BasePart")

            -- Random pick
            if selectedSwordPlayer == "RANDOM" then
                local valid = false
                if currentTarget and currentTarget.Parent and currentTarget.Character then
                    local hum = currentTarget.Character:FindFirstChildOfClass("Humanoid")
                    if hum and hum.Health > 0 then valid = true end
                end
                if not valid then
                    local list = {}
                    for _, p in pairs(Players:GetPlayers()) do
                        if p ~= LocalPlayer and p.Character then
                            local hum = p.Character:FindFirstChildOfClass("Humanoid")
                            if hum and hum.Health > 0 then table.insert(list, p) end
                        end
                    end
                    if #list > 0 then currentTarget = list[math.random(1, #list)] end
                end
            else
                currentTarget = selectedSwordPlayer
            end

            if currentTarget and currentTarget.Character then
                local targetPart = currentTarget.Character:FindFirstChild("Head")
                    or currentTarget.Character:FindFirstChild("UpperTorso")
                    or currentTarget.Character:FindFirstChild("Torso")
                    or currentTarget.Character:FindFirstChild("HumanoidRootPart")
                local tHum = currentTarget.Character:FindFirstChildOfClass("Humanoid")
                if targetPart and tHum and tHum.Health > 0 then
                    myRoot.CFrame = targetPart.CFrame
                    myRoot.AssemblyLinearVelocity = Vector3.zero
                    tool:Activate()
                    if handle and handle:FindFirstChildOfClass("TouchTransmitter") then
                        for _, child in ipairs(currentTarget.Character:GetChildren()) do
                            if child:IsA("BasePart") then
                                firetouchinterest(handle, child, 0)
                                firetouchinterest(handle, child, 1)
                            end
                        end
                    end
                end
            end
        end)
    end
end)

