local function RefreshTelepotMenu()
    for _, child in ipairs(TelepotMenuScroll:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    local locations = _G.SavedTelepotLocations or {}

    for i, location in ipairs(locations) do
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, 0, 0, 27)
        btn.BackgroundColor3 = THEME.ButtonBg
        btn.Text = "#Địa Điểm " .. i
        btn.TextColor3 = THEME.TextDark
        btn.TextSize = 10
        btn.Font = Enum.Font.FredokaOne
        btn.ZIndex = 22
        btn.Parent = TelepotMenuScroll
        CreateCorner(btn, 7)
        CreateStroke(btn, 1, THEME.Border)

        btn.MouseButton1Click:Connect(function()
            if telepotMenuMode == "select" then
                selectedTelepotLocation = i
                SelectedLocationLabel.Text = "Đã Chọn Địa Điểm " .. i
                SelectedLocationLabel.TextColor3 = THEME.Active
                SelectLocationBtn.Text = "Địa Điểm " .. i

            elseif telepotMenuMode == "delete" then
                -- Xóa đúng địa điểm i
                local deletedName = "#Địa Điểm " .. i
                table.remove(_G.SavedTelepotLocations, i)

                -- Điều chỉnh selected
                if selectedTelepotLocation == i then
                    selectedTelepotLocation = nil
                    SelectedLocationLabel.Text = "[ Chưa chọn địa điểm ]"
                    SelectedLocationLabel.TextColor3 = THEME.Accent
                    SelectLocationBtn.Text = "Chọn Địa Điểm"
                elseif selectedTelepotLocation and selectedTelepotLocation > i then
                    selectedTelepotLocation = selectedTelepotLocation - 1
                    SelectedLocationLabel.Text = "Đã Chọn Địa Điểm " .. selectedTelepotLocation
                    SelectLocationBtn.Text = "Địa Điểm " .. selectedTelepotLocation
                end

                SaveSettings()

                TelepotInfoLabel.Text = "Đã Xóa " .. deletedName

                -- Refresh menu để đánh số lại
                task.defer(function()
                    RefreshTelepotMenu()
                end)

                task.delay(1.5, function()
                    if TelepotInfoLabel then
                        TelepotInfoLabel.Text = "Có thể lưu nhiều địa điểm"
                    end
                end)

                -- Không đóng menu để user tiếp tục xóa
                return
            end

            TelepotMenuFrame.Visible = false
        end)
    end

    TelepotMenuScroll.CanvasSize = UDim2.new(0, 0, 0, math.max(#locations * 31, 0))
end

