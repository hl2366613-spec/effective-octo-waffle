-- =========================================================
-- UTILITY
-- =========================================================

local function CreateCorner(parent, radius)
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, radius or 12)
    corner.Parent = parent
    return corner
end

local function CreateStroke(parent, thickness, color)
    local stroke = Instance.new("UIStroke")
    stroke.Color = color or THEME.Border
    stroke.Thickness = thickness or 1.5
    stroke.Transparency = 0
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    stroke.Parent = parent
    return stroke
end

local function FormatTime(seconds)
    if not seconds or seconds ~= seconds or seconds <= 0 then
        return "00:00"
    end
    local mins = math.floor(seconds / 60)
    local secs = math.floor(seconds % 60)
    return string.format("%02d:%02d", mins, secs)
end

-- =========================================================
-- FLOATING BUTTON SYSTEM
-- Mỗi chức năng có 1 nút nổi riêng, hình chữ nhật bo góc
-- =========================================================

local floatingButtons = {}  -- [key] = { frame, updateFn, cleanupFn, closeFn }

local function CreateFloatingButton(key, titleText, width, height)
    -- Nếu đã tồn tại → toggle (đóng)
    if floatingButtons[key] then
        floatingButtons[key].frame:Destroy()
        floatingButtons[key] = nil
        return nil
    end

    local floatFrame = Instance.new("Frame")
    floatFrame.Name = "Float_" .. key
    floatFrame.Size = UDim2.new(0, width or 180, 0, height or 90)
    -- Vị trí mặc định: lệch nhau theo số lượng nút đang mở
    local offsetIndex = 0
    for _ in pairs(floatingButtons) do
        offsetIndex = offsetIndex + 1
    end
    floatFrame.Position = UDim2.new(0, 20 + offsetIndex * 20, 0, 200 + offsetIndex * 90)
    floatFrame.BackgroundColor3 = THEME.MainBg
    floatFrame.BackgroundTransparency = 0.05
    floatFrame.BorderSizePixel = 0
    floatFrame.Active = true
    floatFrame.Draggable = true
    floatFrame.ZIndex = 50
    floatFrame.Parent = FloatingFolder

    CreateCorner(floatFrame, 12)
    CreateStroke(floatFrame, 1.5, THEME.Border)

    -- Thanh tiêu đề
    local titleBar = Instance.new("TextLabel")
    titleBar.Size = UDim2.new(1, -30, 0, 22)
    titleBar.Position = UDim2.new(0, 6, 0, 4)
    titleBar.BackgroundTransparency = 1
    titleBar.Text = titleText
    titleBar.TextColor3 = THEME.Accent
    titleBar.TextSize = 11
    titleBar.Font = Enum.Font.FredokaOne
    titleBar.TextXAlignment = Enum.TextXAlignment.Left
    titleBar.ZIndex = 51
    titleBar.Parent = floatFrame

    -- Nút đóng
    local closeFloat = Instance.new("TextButton")
    closeFloat.Size = UDim2.new(0, 20, 0, 20)
    closeFloat.Position = UDim2.new(1, -24, 0, 4)
    closeFloat.BackgroundColor3 = THEME.ButtonBg
    closeFloat.Text = "✖"
    closeFloat.TextColor3 = THEME.Inactive
    closeFloat.TextSize = 11
    closeFloat.Font = Enum.Font.FredokaOne
    closeFloat.AutoButtonColor = false
    closeFloat.ZIndex = 52
    closeFloat.Parent = floatFrame
    CreateCorner(closeFloat, 6)
    CreateStroke(closeFloat, 1, THEME.Border)

    -- Vùng chứa nội dung
    local contentFrame = Instance.new("Frame")
    contentFrame.Name = "Content"
    contentFrame.Size = UDim2.new(1, -12, 1, -32)
    contentFrame.Position = UDim2.new(0, 6, 0, 28)
    contentFrame.BackgroundTransparency = 1
    contentFrame.ZIndex = 51
    contentFrame.Parent = floatFrame

    local contentLayout = Instance.new("UIListLayout")
    contentLayout.Parent = contentFrame
    contentLayout.Padding = UDim.new(0, 4)
    contentLayout.SortOrder = Enum.SortOrder.LayoutOrder

    local entry = {
        frame = floatFrame,
        content = contentFrame,
        layout = contentLayout,
        close = closeFloat
    }

    closeFloat.MouseButton1Click:Connect(function()
        if floatingButtons[key] then
            floatingButtons[key].frame:Destroy()
            floatingButtons[key] = nil
        end
    end)

    floatingButtons[key] = entry
    return entry
end

-- =========================================================
-- WRAPPER: BUTTON CÓ NÚT [>]
-- =========================================================

-- Tạo button toggle thông thường + nút [>] bên phải
-- Trả về: mainBtn, arrowBtn
local function CreateButtonWithArrow(parent, text, arrowKey, floatTitle, floatW, floatH, buildContentFn)
    -- Container chứa main + arrow
    local container = Instance.new("Frame")
    container.Size = UDim2.new(1, -4, 0, 28)
    container.BackgroundTransparency = 1
    container.Parent = parent

    -- Button chính
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -30, 1, 0)
    btn.Position = UDim2.new(0, 0, 0, 0)
    btn.BackgroundColor3 = THEME.ButtonBg
    btn.Text = text
    btn.TextColor3 = THEME.TextDark
    btn.TextSize = 11
    btn.Font = Enum.Font.FredokaOne
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.AutoButtonColor = false
    btn.Parent = container

    local padding = Instance.new("UIPadding")
    padding.PaddingLeft = UDim.new(0, 9)
    padding.Parent = btn

    CreateCorner(btn, 8)
    CreateStroke(btn, 1, THEME.Border)

    -- Button mũi tên [>]
    local arrow = Instance.new("TextButton")
    arrow.Size = UDim2.new(0, 26, 1, 0)
    arrow.Position = UDim2.new(1, -28, 0, 0)
    arrow.BackgroundColor3 = THEME.ContainerBg
    arrow.Text = ">"
    arrow.TextColor3 = THEME.Accent
    arrow.TextSize = 14
    arrow.Font = Enum.Font.FredokaOne
    arrow.AutoButtonColor = false
    arrow.Parent = container

    CreateCorner(arrow, 8)
    CreateStroke(arrow, 1, THEME.Border)

    -- Khi bấm [>] → mở nút nổi
    arrow.MouseButton1Click:Connect(function()
        local entry = CreateFloatingButton(arrowKey, floatTitle, floatW, floatH)
        if entry and buildContentFn then
            buildContentFn(entry.content, entry.layout, entry)
        end
    end)

    return btn, arrow, container
end

