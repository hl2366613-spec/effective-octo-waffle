    isGlueActive = not isGlueActive
    GlueToggleBtn.Text = isGlueActive and "🎀 Bám onii chan: ON" or "🎀 Bám onii chan: OFF"
    GlueToggleBtn.TextColor3 = isGlueActive and THEME.Active or THEME.Inactive

    if glueConnection then
        glueConnection:Disconnect()
        glueConnection = nil
    end

    if not isGlueActive then return end
    if not selectedGluePlayer then
        isGlueActive = false
        GlueToggleBtn.Text = "🎀 Bám onii chan: OFF"
        GlueToggleBtn.TextColor3 = THEME.Inactive
        return
    end

    glueConnection = RunService.Heartbeat:Connect(function()
        if not isGlueActive then return end
        local targetChar = selectedGluePlayer.Character
        local myChar = LocalPlayer.Character
        if not targetChar or not myChar then return end
        local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
        local myRoot = myChar:FindFirstChild("HumanoidRootPart")
        if targetRoot and myRoot then
            myRoot.CFrame = targetRoot.CFrame * CFrame.new(2, 0, 0)
        end
    end)
end)

