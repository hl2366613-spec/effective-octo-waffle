-- =========================================================
-- SAVE / LOAD
-- =========================================================

local function SaveSettings()
    local data = {
        SavedMusicID = _G.SavedMusicID,
        MusicLoopEnabled = _G.MusicLoopEnabled,
        MusicVolume = _G.MusicVolume,
        MusicSpeed = _G.MusicSpeed,
        SavedTelepotLocations = _G.SavedTelepotLocations
    }

    pcall(function()
        if writefile then
            writefile(SAVE_FILE_NAME, HttpService:JSONEncode(data))
        end
    end)
end

local function LoadSettings()
    pcall(function()
        if readfile and isfile and isfile(SAVE_FILE_NAME) then
            local decoded = HttpService:JSONDecode(readfile(SAVE_FILE_NAME))

            if decoded then
                if decoded.SavedMusicID then
                    _G.SavedMusicID = decoded.SavedMusicID
                end
                if decoded.MusicLoopEnabled ~= nil then
                    _G.MusicLoopEnabled = decoded.MusicLoopEnabled
                end
                if decoded.MusicVolume then
                    _G.MusicVolume = decoded.MusicVolume
                end
                if decoded.MusicSpeed then
                    _G.MusicSpeed = decoded.MusicSpeed
                end
                if decoded.SavedTelepotLocations then
                    _G.SavedTelepotLocations = decoded.SavedTelepotLocations
                end
            end
        end
    end)
end

LoadSettings()

