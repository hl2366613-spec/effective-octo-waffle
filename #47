                nameLbl.Text = MusicInfoLabel.Text
                playBtn.Text = isPlayingMusic and "stoping" or "playing"
                playBtn.TextColor3 = isPlayingMusic and THEME.Inactive or THEME.Active
                task.wait(0.4)
            end
        end)

        playBtn.MouseButton1Click:Connect(function()
            MusicPlayBtn.MouseButton1Click:Fire()
        end)

        loopFloat.MouseButton1Click:Connect(function()
            isLoopEnabled = not isLoopEnabled
            _G.MusicLoopEnabled = isLoopEnabled
            loopFloat.Text = isLoopEnabled and "Lặp lại: BẬT" or "Lặp lại: TẮT"
