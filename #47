        local loopFloat = Instance.new("TextButton")
        loopFloat.Size = UDim2.new(1, 0, 0, 26)
        loopFloat.BackgroundColor3 = THEME.ButtonBg
        loopFloat.Text = isLoopEnabled and "Lặp lại: BẬT" or "Lặp lại: TẮT"
