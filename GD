local function Button(Parent, Text, Y, Width)

    local B = Instance.new("TextButton")
    B.Size = UDim2.new(1, -(Width or 18), 0, 30)
    B.Position = UDim2.fromOffset((Width or 18)/2, Y)
    B.BackgroundColor3 = PANEL2
    B.Text = Text
    B.TextColor3 = WHITE
    B.TextSize = 11
    B.Font = Enum.Font.GothamMedium
    B.AutoButtonColor = false
    B.Parent = Parent

    Corner(B, 6)
    Border(B, Color3.fromRGB(75,25,110), 1)

    B.MouseEnter:Connect(function()
        Tween(B,.15,{
            BackgroundColor3 = Color3.fromRGB(50,20,75)
        })
    end)

    B.MouseLeave:Connect(function()
        Tween(B,.15,{
            BackgroundColor3 = PANEL2
        })
    end)

    return B
end

