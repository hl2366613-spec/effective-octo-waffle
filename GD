local function Toggle(Parent, Text, Y, Enabled)

    local Label = NewText(
        Parent,
        Text,
        UDim2.new(1,-55,0,24),
        UDim2.fromOffset(9,Y),
        11,
        GREY
    )

    local T = Instance.new("TextButton")
    T.Size = UDim2.fromOffset(36,20)
    T.Position = UDim2.new(1,-46,0,Y+1)
    T.BackgroundColor3 =
        Enabled
        and PURPLE
        or Color3.fromRGB(48,45,58)

    T.Text = ""
    T.AutoButtonColor = false
    T.Parent = Parent

    Corner(T,12)

    local Dot = Instance.new("Frame")
    Dot.Size = UDim2.fromOffset(14,14)
    Dot.BackgroundColor3 = WHITE
    Dot.Parent = T

    Corner(Dot,10)

    local State = Enabled

    local function Update()

        Tween(T,.15,{
            BackgroundColor3 =
                State
                and PURPLE
                or Color3.fromRGB(48,45,58)
        })

        Tween(Dot,.15,{
            Position =
                State
                and UDim2.new(1,-17,.5,-7)
                or UDim2.fromOffset(3,3)
        })
    end

    Dot.Position =
        Enabled
        and UDim2.new(1,-17,.5,-7)
        or UDim2.fromOffset(3,3)

    T.MouseButton1Click:Connect(function()
        State = not State
        Update()
    end)

    return T
end

