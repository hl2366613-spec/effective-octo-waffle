-- ==================== RAINBOW ANIMATION (ĐỔI MÀU BẢNG & NÚT & VIỀN) ====================

local hue = 0
RunService.Heartbeat:Connect(function(delta)
    hue = (hue + delta * 0.35) % 1
    currentRainbowColor = Color3.fromHSV(hue, 0.85, 1)

    -- Đổi màu viền
    TopLine.BackgroundColor3 = currentRainbowColor
    Title.TextColor3 = currentRainbowColor
    VersionLabel.TextColor3 = currentRainbowColor

    for _, stroke in ipairs(RainbowStrokes) do
        if stroke and stroke.Parent then 
            stroke.Color = currentRainbowColor 
        end
    end

    -- Đổi màu nền nút bấm liên tục
    for _, btn in ipairs(RainbowButtons) do
        if btn and btn.Parent then
            btn.BackgroundColor3 = currentRainbowColor
        end
    end
end)
