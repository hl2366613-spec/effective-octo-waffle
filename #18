-- ==================== CHỨC NĂNG PHÁT NHẠC ====================

local isPlaying = false
local isLoop = _G.MusicLoopEnabled

local function LoadSongInfo(id)
    local numericId = id:gsub("%D", "")
    if numericId == "" then return end
    
    task.spawn(function()
        pcall(function()
            local assetInfo = MarketplaceService:GetProductInfo(tonumber(numericId))
            if assetInfo and assetInfo.Name then
                SongTitle.Text = assetInfo.Name
                SongAuthorTime.Text = (assetInfo.Creator.Name or "Unknown") .. " | 3:18"
            end
        end)
    end)
    
    localSound.SoundId = "rbxassetid://" .. numericId
end

PlayControlBtn.MouseButton1Click:Connect(function()
    local id = MusicIDInput.Text:gsub("%D", "")
    if id ~= "" then
        LoadSongInfo(id)
        localSound:Play()
        isPlaying = true
    end
end)

PauseControlBtn.MouseButton1Click:Connect(function()
    if isPlaying then
        localSound:Pause()
        isPlaying = false
    else
        localSound:Resume()
        isPlaying = true
    end
end)

StopControlBtn.MouseButton1Click:Connect(function()
    localSound:Stop()
    isPlaying = false
end)

LoopBtn.MouseButton1Click:Connect(function()
    isLoop = not isLoop
    _G.MusicLoopEnabled = isLoop
    localSound.Looped = isLoop
    LoopBtn.Text = isLoop and "Vòng lặp: BẬT" or "Vòng lặp: TẮT"
end)

localSound.TimeChanged:Connect(function(time)
    local curMins = math.floor(time / 60)
    local curSecs = math.floor(time % 60)
    local maxMins = math.floor(localSound.TimeLength / 60)
    local maxSecs = math.floor(localSound.TimeLength % 60)
    TimeLabel.Text = string.format("%d:%02d / %d:%02d", curMins, curSecs, maxMins, maxSecs)
end)

-- Kéo Slider Âm lượng
local draggingVol = false
VolSliderBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        draggingVol = true
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        draggingVol = false
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if draggingVol and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local pos = math.clamp((input.Position.X - VolSliderBar.AbsolutePosition.X) / VolSliderBar.AbsoluteSize.X, 0, 1)
        VolSliderFill.Size = UDim2.new(pos, 0, 1, 0)
        VolSliderKnob.Position = UDim2.new(pos, -7, 0.5, -7)
        local volValue = math.floor(pos * 100)
        _G.MusicVolume = volValue
        VolTextLabel.Text = "THỂ TÍCH " .. volValue .. "%"
        localSound.Volume = pos
    end
end)

